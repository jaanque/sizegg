---
export interface Props {
	lang: 'es' | 'en';
}

const { lang } = Astro.props;

const labels = {
	es: {
		text: 'emotes procesados'
	},
	en: {
		text: 'emotes processed'
	}
};

const t = labels[lang];

let initialCount = 15449;
try {
	const res = await fetch('https://yotkdsnmcgpcwdygtpyi.supabase.co/rest/v1/counters?id=eq.image_uploads&select=count', {
		headers: {
			'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdGtkc25tY2dwY3dkeWd0cHlpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYxOTQ3OTYsImV4cCI6MjEwMTc3MDc5Nn0.WxRgm7yB-UxNe_kkaf4lk7_etS_9L8FXxLK0EAnS0LM'
		}
	});
	if (res.ok) {
		const json = await res.json();
		if (json && json[0] && json[0].count) {
			initialCount = Number(json[0].count);
		}
	}
} catch (e) {}
---

<div class="counter-box" id="global-counter-wrapper">
	<span class="counter-number" id="global-counter-val">{initialCount.toLocaleString()}</span>
	<span class="counter-text">{t.text}</span>
</div>

<style>
	.counter-box {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--text-primary);
		background-color: var(--surface-card);
		border: 1px solid var(--border-color);
		padding: 0.55rem 1.25rem;
		border-radius: 22px;
		margin-top: 0.75rem;
	}

	.counter-number {
		color: #a970ff;
		font-size: 1.35rem;
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		display: inline-block;
		transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.counter-number.bump {
		transform: scale(1.18);
	}

	.counter-text {
		color: var(--text-muted);
		font-weight: 600;
	}
</style>

<script>
	function animateValue(el: HTMLElement, start: number, end: number, duration: number = 1200) {
		if (start === end) {
			el.textContent = end.toLocaleString();
			return;
		}

		const startTime = performance.now();

		function update(currentTime: number) {
			const elapsed = currentTime - startTime;
			const progress = Math.min(elapsed / duration, 1);
			
			// Easing out cubic
			const easeOut = 1 - Math.pow(1 - progress, 3);
			const current = Math.floor(start + (end - start) * easeOut);

			el.textContent = current.toLocaleString();

			if (progress < 1) {
				requestAnimationFrame(update);
			} else {
				el.textContent = end.toLocaleString();
				el.classList.add('bump');
				setTimeout(() => el.classList.remove('bump'), 200);
			}
		}

		requestAnimationFrame(update);
	}

	async function loadCounter() {
		const el = document.getElementById('global-counter-val');
		if (!el) return;

		const currentRendered = parseInt(el.textContent?.replace(/[^0-9]/g, '') || '0', 10);
		const cachedVal = localStorage.getItem('sizegg_counter_cache');
		const startVal = Math.max(currentRendered, cachedVal ? parseInt(cachedVal, 10) || 0 : 0);

		let fetchedCount: number | null = null;

		try {
			const { supabase } = await import('../lib/supabase');
			const { data, error } = await supabase
				.from('counters')
				.select('count')
				.eq('id', 'image_uploads')
				.single();

			if (!error && data && data.count !== undefined && data.count !== null) {
				fetchedCount = Number(data.count);
			}
		} catch (e) {}

		if (fetchedCount === null) {
			try {
				const res = await fetch('https://yotkdsnmcgpcwdygtpyi.supabase.co/rest/v1/counters?id=eq.image_uploads&select=count', {
					headers: {
						'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdGtkc25tY2dwY3dkeWd0cHlpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYxOTQ3OTYsImV4cCI6MjEwMTc3MDc5Nn0.WxRgm7yB-UxNe_kkaf4lk7_etS_9L8FXxLK0EAnS0LM'
					}
				});
				if (res.ok) {
					const json = await res.json();
					if (json && json[0] && json[0].count !== undefined) {
						fetchedCount = Number(json[0].count);
					}
				}
			} catch (err) {}
		}

		if (fetchedCount !== null) {
			localStorage.setItem('sizegg_counter_cache', fetchedCount.toString());
			if (fetchedCount !== startVal) {
				animateValue(el, startVal, fetchedCount, 1400);
			} else {
				el.textContent = fetchedCount.toLocaleString();
			}
		}
	}

	function initCounter() {
		loadCounter();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initCounter);
	} else {
		initCounter();
	}
	window.addEventListener('load', initCounter);
	document.addEventListener('astro:page-load', initCounter);

	window.addEventListener('counter:incremented', () => {
		const el = document.getElementById('global-counter-val');
		if (el) {
			const rawText = el.textContent?.replace(/[^0-9]/g, '') || '0';
			const current = parseInt(rawText, 10) || 0;
			const newVal = current + 1;
			el.textContent = newVal.toLocaleString();
			el.classList.add('bump');
			setTimeout(() => el.classList.remove('bump'), 250);
			localStorage.setItem('sizegg_counter_cache', newVal.toString());
		}
	});
</script>
