---
export interface Props {
	lang: 'es' | 'en';
}

const { lang } = Astro.props;

const labels = {
	es: {
		text: 'emotes procesados'
	},
	en: {
		text: 'emotes processed'
	}
};

const t = labels[lang];

let initialCount = 15449;
try {
	const res = await fetch('https://yotkdsnmcgpcwdygtpyi.supabase.co/rest/v1/counters?id=eq.image_uploads&select=count', {
		headers: {
			'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdGtkc25tY2dwY3dkeWd0cHlpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYxOTQ3OTYsImV4cCI6MjEwMTc3MDc5Nn0.WxRgm7yB-UxNe_kkaf4lk7_etS_9L8FXxLK0EAnS0LM'
		}
	});
	if (res.ok) {
		const json = await res.json();
		if (json && json[0] && json[0].count) {
			initialCount = Number(json[0].count);
		}
	}
} catch (e) {}
---

<div class="counter-box" id="global-counter-wrapper">
	<span class="counter-number-viewport" id="counter-viewport">
		<span class="counter-number" id="global-counter-val">{initialCount.toLocaleString()}</span>
	</span>
	<span class="counter-text">{t.text}</span>
</div>

<style>
	.counter-box {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--text-primary);
		background-color: var(--surface-card);
		border: 1px solid var(--border-color);
		padding: 0.6rem 1.35rem;
		border-radius: 22px;
		margin-top: 0.75rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
	}

	.counter-number-viewport {
		display: inline-flex;
		position: relative;
		overflow: hidden;
		vertical-align: middle;
		height: 1.8em;
		align-items: center;
		justify-content: center;
		min-width: 4rem;
	}

	.counter-number {
		color: #a970ff;
		font-size: 1.45rem;
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		display: inline-block;
		line-height: 1.8em;
		will-change: transform, opacity, filter;
		letter-spacing: -0.02em;
	}

	.counter-text {
		color: var(--text-muted);
		font-weight: 600;
	}
</style>

<script>
	function animateValue(el: HTMLElement, start: number, end: number, duration: number = 2200) {
		if (start === end) {
			el.textContent = end.toLocaleString();
			return;
		}

		const startTime = performance.now();

		function update(currentTime: number) {
			const elapsed = currentTime - startTime;
			const progress = Math.min(elapsed / duration, 1);
			
			// Easing out quintic para desaceleración extremadamente suave y elegante
			const easeOut = 1 - Math.pow(1 - progress, 5);
			const current = Math.floor(start + (end - start) * easeOut);

			el.textContent = current.toLocaleString();

			if (progress < 1) {
				requestAnimationFrame(update);
			} else {
				el.textContent = end.toLocaleString();
			}
		}

		requestAnimationFrame(update);
	}

	function slideUpdateValue(viewport: HTMLElement, oldEl: HTMLElement, endVal: number) {
		const formattedNew = endVal.toLocaleString();
		if (oldEl.textContent === formattedNew) return;

		const newEl = document.createElement('span');
		newEl.className = 'counter-number';
		newEl.id = 'global-counter-val';
		newEl.textContent = formattedNew;
		newEl.style.position = 'absolute';
		newEl.style.top = '0';
		newEl.style.left = '0';
		newEl.style.transform = 'translateY(120%) scale(0.88)';
		newEl.style.opacity = '0';
		newEl.style.filter = 'blur(4px)';

		oldEl.removeAttribute('id');
		oldEl.style.transition = 'transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease, filter 0.5s ease';
		newEl.style.transition = 'transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease, filter 0.5s ease';

		viewport.appendChild(newEl);

		// Forzar reflow para desencadenar la animación
		void newEl.offsetWidth;

		oldEl.style.transform = 'translateY(-120%) scale(0.88)';
		oldEl.style.opacity = '0';
		oldEl.style.filter = 'blur(4px)';

		newEl.style.transform = 'translateY(0) scale(1)';
		newEl.style.opacity = '1';
		newEl.style.filter = 'blur(0px)';

		setTimeout(() => {
			oldEl.remove();
			newEl.style.position = 'relative';
		}, 660);
	}

	async function loadCounter() {
		const el = document.getElementById('global-counter-val');
		if (!el) return;

		let fetchedCount: number | null = null;

		try {
			const { supabase } = await import('../lib/supabase');
			const { data, error } = await supabase
				.from('counters')
				.select('count')
				.eq('id', 'image_uploads')
				.single();

			if (!error && data && data.count !== undefined && data.count !== null) {
				fetchedCount = Number(data.count);
			}
		} catch (e) {}

		if (fetchedCount === null) {
			try {
				const res = await fetch('https://yotkdsnmcgpcwdygtpyi.supabase.co/rest/v1/counters?id=eq.image_uploads&select=count', {
					headers: {
						'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdGtkc25tY2dwY3dkeWd0cHlpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYxOTQ3OTYsImV4cCI6MjEwMTc3MDc5Nn0.WxRgm7yB-UxNe_kkaf4lk7_etS_9L8FXxLK0EAnS0LM'
					}
				});
				if (res.ok) {
					const json = await res.json();
					if (json && json[0] && json[0].count !== undefined) {
						fetchedCount = Number(json[0].count);
					}
				}
			} catch (err) {}
		}

		if (fetchedCount !== null && fetchedCount > 0) {
			localStorage.setItem('sizegg_counter_cache', fetchedCount.toString());
			animateValue(el, 0, fetchedCount, 1300);
		}
	}

	function initCounter() {
		loadCounter();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initCounter);
	} else {
		initCounter();
	}
	window.addEventListener('load', initCounter);
	document.addEventListener('astro:page-load', initCounter);

	window.addEventListener('counter:incremented', (e: Event) => {
		const viewport = document.getElementById('counter-viewport');
		const el = document.getElementById('global-counter-val');
		if (viewport && el) {
			const detail = (e as CustomEvent)?.detail;
			const amount = detail && typeof detail.amount === 'number' ? detail.amount : 1;
			const rawText = el.textContent?.replace(/[^0-9]/g, '') || '0';
			const current = parseInt(rawText, 10) || 0;
			const newVal = current + amount;
			slideUpdateValue(viewport, el, newVal);
			localStorage.setItem('sizegg_counter_cache', newVal.toString());
		}
	});
</script>
