---
export interface Props {
	lang: 'es' | 'en';
	platformId: 'twitch' | 'kick' | 'discord' | 'youtube' | '7tv' | 'bttv';
	accentColor?: string;
}

const { lang, platformId, accentColor = '#a970ff' } = Astro.props;

const labels = {
	es: {
		dragTitle: 'Sueltas tus imágenes aquí',
		dragOr: 'o haz clic para buscar en tu dispositivo',
		supportedFormats: 'Soporta PNG, JPG, WebP, GIF, SVG, HEIC y más',
		uploading: 'Procesando imágenes...',
		downloadAll: 'Descargar todo (.ZIP)',
		downloadSingle: 'Descargar',
		clearAll: 'Limpiar lista',
		filesProcessed: 'archivos procesados',
		invalidFile: 'Formato no compatible',
		specs: {
			twitch: 'Formato Twitch: 112×112, 56×56 y 28×28 px',
			kick: 'Formato Kick: 500×500 px (Máx 1 MB)',
			discord: 'Formato Discord: 128×128 px (Máx 256 KB)',
			youtube: 'Formato YouTube: 480×480 px (Máx 1 MB)',
			'7tv': 'Formato 7TV: 128×128 px (WebP / GIF)',
			bttv: 'Formato BTTV: 112×112, 56×56 y 28×28 px'
		}
	},
	en: {
		dragTitle: 'Drop your images here',
		dragOr: 'or click to browse your device',
		supportedFormats: 'Supports PNG, JPG, WebP, GIF, SVG, HEIC & more',
		uploading: 'Processing images...',
		downloadAll: 'Download All (.ZIP)',
		downloadSingle: 'Download',
		clearAll: 'Clear list',
		filesProcessed: 'files processed',
		invalidFile: 'Unsupported format',
		specs: {
			twitch: 'Twitch format: 112×112, 56×56 & 28×28 px',
			kick: 'Kick format: 500×500 px (Max 1 MB)',
			discord: 'Discord format: 128×128 px (Max 256 KB)',
			youtube: 'YouTube format: 480×480 px (Max 1 MB)',
			'7tv': '7TV format: 128×128 px (WebP / GIF)',
			bttv: 'BTTV format: 112×112, 56×56 & 28×28 px'
		}
	}
};

const t = labels[lang];
const specText = t.specs[platformId] || t.specs.twitch;
---

<div class="dropzone-container" data-platform={platformId} data-lang={lang}>
	<div class="dropzone" style={`--accent-color: ${accentColor};`}>
		<input type="file" class="file-input" multiple accept="image/*" style="display: none;" />
		
		<div class="drop-prompt" id="drop-prompt">
			<div class="icon-box">
				<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
					<polyline points="17 8 12 3 7 8"></polyline>
					<line x1="12" y1="3" x2="12" y2="15"></line>
				</svg>
			</div>
			<div class="prompt-text">
				<h2>{t.dragTitle}</h2>
				<p>{t.dragOr}</p>
			</div>
		</div>

		<div class="loader" id="loader" style="display: none;">
			<div class="spinner"></div>
			<p>{t.uploading}</p>
		</div>
	</div>

	<div class="dropzone-info-card" style={`--accent-color: ${accentColor};`}>
		<div class="info-card-item">
			<div class="info-card-icon">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="3" width="18" height="18" rx="2"></rect>
					<path d="M7 7h10"></path>
					<path d="M7 12h10"></path>
					<path d="M7 17h10"></path>
				</svg>
			</div>
			<div class="info-card-text">{specText}</div>
		</div>
		<div class="info-card-item">
			<div class="info-card-icon">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
					<polyline points="14 2 14 8 20 8"></polyline>
				</svg>
			</div>
			<div class="info-card-text">{t.supportedFormats}</div>
		</div>
	</div>

	<!-- Notificación visual de error intuitiva -->
	<div class="error-toast" id="error-toast" style="display: none;">
		<div class="error-toast-icon">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="12" y1="8" x2="12" y2="12"></line>
				<line x1="12" y1="16" x2="12.01" y2="16"></line>
			</svg>
		</div>
		<div class="error-toast-content">
			<h4 class="error-toast-title" id="error-toast-title"></h4>
			<p class="error-toast-desc" id="error-toast-desc"></p>
		</div>
		<button class="error-toast-close" id="error-toast-close" title="Cerrar">&times;</button>
	</div>

	<!-- Modal Interactivo de Recorte / Ajuste (Crop Modal) -->
	<div class="crop-modal-overlay" id="crop-modal" style="display: none;">
		<div class="crop-modal-content">
			<div class="crop-modal-header">
				<div class="crop-modal-title">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M6 2v14a2 2 0 0 0 2 2h14"></path>
						<path d="M18 22V8a2 2 0 0 0-2-2H2"></path>
					</svg>
					<span>{lang === 'es' ? 'Recorte Cuadrado (1:1)' : 'Square Crop (1:1)'}</span>
				</div>
				<button class="btn-crop-close" id="btn-crop-close">&times;</button>
			</div>

			<div class="crop-modal-body">
				<p class="crop-instructions">
					{lang === 'es' 
						? 'Tu imagen no es cuadrada. Ajusta y centra el encuadre (1:1) antes de procesarla.' 
						: 'Your image is not square. Adjust and center the (1:1) crop frame before processing.'}
				</p>
				<div class="crop-canvas-wrapper">
					<canvas id="crop-canvas"></canvas>
				</div>
				<div class="crop-controls">
					<label>{lang === 'es' ? 'Zoom y Encuadre:' : 'Zoom & Frame:'}</label>
					<input type="range" id="crop-zoom-range" min="1" max="3" step="0.05" value="1" />
				</div>
			</div>

			<div class="crop-modal-footer">
				<button class="btn-crop-cancel" id="btn-crop-cancel">{lang === 'es' ? 'Omitir' : 'Skip'}</button>
				<button class="btn-crop-confirm" id="btn-crop-confirm" style={`--accent-color: ${accentColor};`}>
					{lang === 'es' ? 'Aplicar Recorte y Procesar' : 'Apply Crop & Process'}
				</button>
			</div>
		</div>
	</div>

	<!-- Resultados e imágenes generadas -->
	<div class="results-wrapper" id="results-wrapper" style="display: none;">
		<div class="results-list" id="results-list"></div>

		<div class="results-footer-bar">
			<span class="results-hint">{lang === 'es' ? 'Puedes hacer clic en cualquiera de las imágenes para guardarla en tu ordenador.' : 'You can click any of the images above to save it to your computer.'}</span>
			<div class="results-actions">
				<button class="btn-clear" id="btn-clear">{lang === 'es' ? 'Limpiar' : 'Clear'}</button>
				<button class="btn-download-all" id="btn-download-all" style={`--accent-color: ${accentColor};`}>
					<span>{lang === 'es' ? 'Guardar todo (.zip)' : 'Save all (.zip)'}</span>
				</button>
			</div>
		</div>
	</div>

</div>

<style>
	.dropzone-container {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		box-sizing: border-box;
	}

	.dropzone {
		width: 100%;
		min-height: 460px;
		background-color: var(--surface-card);
		border: 2px dashed var(--border-color);
		border-radius: 24px;
		padding: 5.25rem 2rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		box-sizing: border-box;
		transition: border-color 0.2s ease, background-color 0.2s ease;
	}

	@media (max-width: 480px) {
		.dropzone {
			min-height: 320px;
			padding: 3.25rem 1.25rem;
			border-radius: 20px;
		}

		.prompt-text h2 {
			font-size: 1.25rem;
		}

		.prompt-text p {
			font-size: 0.9rem;
		}

		.icon-box {
			width: 66px;
			height: 66px;
			border-radius: 18px;
		}

		.icon-box svg {
			width: 32px;
			height: 32px;
		}
	}

	.dropzone:hover,
	.dropzone.drag-over {
		border-color: var(--accent-color);
		background-color: var(--surface-hover);
	}

	.drop-prompt {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.35rem;
		text-align: center;
		pointer-events: none;
	}

	.icon-box {
		width: 84px;
		height: 84px;
		border-radius: 24px;
		background-color: var(--surface-hover);
		border: 1px solid var(--border-color);
		color: var(--accent-color);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.prompt-text h2 {
		font-size: 1.65rem;
		font-weight: 800;
		color: var(--text-primary);
		margin-bottom: 0.35rem;
		letter-spacing: -0.01em;
	}

	.prompt-text p {
		font-size: 1.08rem;
		color: var(--text-muted);
		font-weight: 500;
	}

	.dropzone-info-card {
		margin: 0.9rem auto 0 auto;
		padding: 0.55rem 1.15rem;
		background-color: var(--surface-card);
		border: 1px solid var(--border-color);
		border-radius: 14px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		width: fit-content;
		max-width: 100%;
		box-sizing: border-box;
	}

	.info-card-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.info-card-icon {
		width: 24px;
		height: 24px;
		border-radius: 7px;
		background-color: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.06);
		color: var(--accent-color, #a970ff);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.info-card-text {
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--text-muted);
		line-height: 1.3;
		white-space: nowrap;
	}

	@media (max-width: 768px) {
		.dropzone-info-card {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
			width: 100%;
			margin-top: 0.85rem;
			padding: 0.75rem 1rem;
			border-radius: 16px;
		}

		.info-card-item {
			width: 100%;
			gap: 0.6rem;
		}

		.info-card-icon {
			width: 26px;
			height: 26px;
			border-radius: 8px;
		}

		.info-card-text {
			white-space: normal;
			word-break: break-word;
			font-size: 0.81rem;
			line-height: 1.35;
		}
	}

	/* Loader */
	.loader {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		color: var(--text-muted);
		font-size: 0.9rem;
		font-weight: 600;
	}

	.spinner {
		width: 32px;
		height: 32px;
		border: 3px solid var(--border-color);
		border-top-color: var(--accent-color);
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	@keyframes spin {
		to { transform: rotate(360deg); }
	}

	/* Error Toast Banner */
	.error-toast {
		width: 100%;
		background-color: rgba(255, 79, 77, 0.08);
		border: 1px solid rgba(255, 79, 77, 0.3);
		border-radius: 22px;
		padding: 0.9rem 1.25rem;
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
		box-sizing: border-box;
	}

	.error-toast-icon {
		color: #ff4f4d;
		flex-shrink: 0;
		margin-top: 0.1rem;
	}

	.error-toast-content {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		flex: 1;
	}

	.error-toast-title {
		font-size: 0.92rem;
		font-weight: 700;
		color: #ff6b6b;
		margin: 0;
	}

	.error-toast-desc {
		font-size: 0.84rem;
		color: var(--text-muted);
		margin: 0;
		line-height: 1.45;
	}

	.error-toast-close {
		background: none;
		border: none;
		color: var(--text-muted);
		font-size: 1.4rem;
		cursor: pointer;
		line-height: 1;
		padding: 0 0.2rem;
		transition: color 0.15s ease;
	}

	.error-toast-close:hover {
		color: var(--text-primary);
	}

	/* Contenedor Card Principal de Resultados */
	.results-wrapper {
		background-color: var(--surface-card);
		border: 1px solid var(--border-color);
		border-radius: 22px;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	.results-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	:global(.file-result-container) {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	:global(.category-block) {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	:global(.category-title) {
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		color: var(--text-muted);
		text-transform: uppercase;
	}

	:global(.items-grid) {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1rem;
		width: 100%;
	}

	:global(.item-card) {
		background-color: var(--bg-body);
		border: 1px solid var(--border-color);
		border-radius: 18px;
		overflow: hidden;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}

	:global(.item-card:hover) {
		border-color: var(--text-muted);
		background-color: var(--surface-hover);
	}

	:global(.card-preview-area) {
		height: 130px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 12px;
		box-sizing: border-box;
	}

	:global(.card-preview-area img) {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		image-rendering: -webkit-optimize-contrast;
		image-rendering: crisp-edges;
	}

	:global(.card-meta-bar) {
		background-color: rgba(255, 255, 255, 0.04);
		border-top: 1px solid var(--border-color);
		padding: 0.55rem 0.75rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: var(--text-primary);
		font-size: 0.78rem;
		font-weight: 700;
		box-sizing: border-box;
	}

	:global(.item-dim) {
		font-weight: 700;
		color: var(--text-primary);
	}

	:global(.item-size) {
		font-weight: 600;
		color: var(--text-muted);
	}

	/* Pie de resultados dentro de la Card */
	.results-footer-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border-color);
		flex-wrap: wrap;
	}

	.results-hint {
		font-size: 0.88rem;
		color: var(--text-muted);
		font-weight: 500;
	}

	.results-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.btn-clear {
		background-color: transparent;
		border: 1px solid var(--border-color);
		color: var(--text-muted);
		font-family: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.55rem 1.1rem;
		border-radius: 22px;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-clear:hover {
		color: var(--text-primary);
		background-color: var(--surface-hover);
	}

	.btn-download-all {
		background-color: var(--accent-color, #a970ff);
		color: #000000;
		font-family: inherit;
		font-size: 0.85rem;
		font-weight: 800;
		padding: 0.55rem 1.2rem;
		border-radius: 22px;
		border: none;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		transition: opacity 0.15s ease;
	}

	.btn-download-all:hover {
		opacity: 0.9;
	}

	/* Estilos Modal de Recorte Cuadrado (Crop Modal) */
	.crop-modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.75);
		backdrop-filter: blur(4px);
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.crop-modal-content {
		background-color: var(--surface-card);
		border: 1px solid var(--border-color);
		border-radius: 22px;
		width: 100%;
		max-width: 440px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
	}

	.crop-modal-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.25rem;
		border-bottom: 1px solid var(--border-color);
	}

	.crop-modal-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text-primary);
	}

	.btn-crop-close {
		background: none;
		border: none;
		color: var(--text-muted);
		font-size: 1.5rem;
		cursor: pointer;
		line-height: 1;
	}

	.btn-crop-close:hover {
		color: var(--text-primary);
	}

	.crop-modal-body {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.crop-instructions {
		font-size: 0.8rem;
		color: var(--text-muted);
		text-align: center;
		margin: 0;
	}

	.crop-canvas-wrapper {
		width: 240px;
		height: 240px;
		background: repeating-conic-gradient(rgba(255, 255, 255, 0.05) 0% 25%, transparent 0% 50%) 50% / 16px 16px;
		border: 2px dashed var(--accent-color, #a970ff);
		border-radius: 22px;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	@media (max-width: 400px) {
		.crop-canvas-wrapper {
			width: 200px;
			height: 200px;
		}
		.crop-modal-footer {
			flex-direction: column;
			gap: 0.5rem;
		}
		.btn-crop-cancel,
		.btn-crop-confirm {
			width: 100%;
			text-align: center;
			justify-content: center;
		}
	}

	#crop-canvas {
		display: block;
		cursor: grab;
	}

	#crop-canvas:active {
		cursor: grabbing;
	}

	.crop-controls {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: 0.75rem;
		color: var(--text-primary);
		font-weight: 600;
	}

	.crop-controls input[type="range"] {
		width: 100%;
		accent-color: var(--accent-color, #a970ff);
	}

	.crop-modal-footer {
		padding: 0.85rem 1.25rem;
		background-color: var(--bg-body);
		border-top: 1px solid var(--border-color);
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
	}

	.btn-crop-cancel {
		background: transparent;
		border: 1px solid var(--border-color);
		color: var(--text-muted);
		padding: 0.45rem 0.85rem;
		border-radius: 22px;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
	}

	.btn-crop-cancel:hover {
		color: var(--text-primary);
		border-color: var(--text-muted);
	}

	.btn-crop-confirm {
		background: var(--accent-color, #a970ff);
		border: none;
		color: #fff;
		padding: 0.45rem 1rem;
		border-radius: 22px;
		font-size: 0.8rem;
		font-weight: 700;
		cursor: pointer;
		transition: opacity 0.15s ease;
	}

	.btn-crop-confirm:hover {
		opacity: 0.9;
	}

	:global(.chat-simulator-box) {
		background-color: var(--bg-body);
		border: 1px solid var(--border-color);
		border-radius: 22px;
		padding: 0.85rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		width: 100%;
		box-sizing: border-box;
	}

	:global(.chat-sim-header) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--text-muted);
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 0.4rem;
	}

	:global(.chat-sim-title) {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--text-primary);
	}

	:global(.chat-sim-live-badge) {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		color: #ff4f4d;
		font-weight: 800;
		font-size: 0.65rem;
		background: rgba(255, 79, 77, 0.1);
		padding: 0.1rem 0.35rem;
		border-radius: 22px;
	}

	:global(.chat-sim-live-dot) {
		width: 5px;
