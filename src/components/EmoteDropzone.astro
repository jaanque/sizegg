		background-color: #ff4f4d;
		border-radius: 50%;
	}

	:global(.chat-sim-messages) {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		font-size: 0.82rem;
		font-family: Inter, system-ui, -apple-system, sans-serif;
	}

	:global(.chat-msg-row) {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		line-height: 1.4;
		padding: 0.15rem 0.25rem;
		border-radius: 22px;
	}

	:global(.chat-user-badge) {
		padding: 0.08rem 0.28rem;
		border-radius: 22px;
		font-size: 0.6rem;
		font-weight: 800;
		color: #fff;
		background-color: var(--accent-color, #a970ff);
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	:global(.chat-user-badge.badge-vip) { background-color: #e024b3; color: #fff; }
	:global(.chat-user-badge.badge-sub) { background-color: #00e6cb; color: #000; }
	:global(.chat-user-badge.badge-kick-mod) { background-color: #53fc18; color: #000; }
	:global(.chat-user-badge.badge-kick-sub) { background-color: #16a34a; color: #fff; }
	:global(.chat-user-badge.badge-discord-bot) { background-color: #5865f2; color: #fff; }
	:global(.chat-user-badge.badge-discord-nitro) { background-color: #f47fff; color: #000; }
	:global(.chat-user-badge.badge-yt-member) { background-color: #2ba640; color: #fff; }
	:global(.chat-user-badge.badge-yt-mod) { background-color: #065fd4; color: #fff; }
	:global(.chat-user-badge.badge-7tv) { background-color: #38bdf8; color: #000; }
	:global(.chat-user-badge.badge-7tv-pro) { background-color: #0284c7; color: #fff; }
	:global(.chat-user-badge.badge-bttv) { background-color: #f97316; color: #fff; }
	:global(.chat-user-badge.badge-bttv-pro) { background-color: #ea580c; color: #fff; }

	:global(.chat-username) {
		font-weight: 700;
	}

	:global(.chat-username.u1) { color: #0099ff; }
	:global(.chat-username.u2) { color: #00ff7f; }
	:global(.chat-username.u3) { color: #ff69b4; }

	:global(.chat-text) {
		color: #efeff1;
		font-weight: 400;
	}

	:global(.chat-emote-img) {
		height: 24px;
		width: auto;
		max-width: 48px;
		object-fit: contain;
		vertical-align: middle;
		display: inline-block;
		margin: 0 0.1rem;
	}

	:global(.btn-download-single:hover) {
		border-color: var(--text-muted);
		background: var(--border-color);
	}
</style>

<script>
	import { processEmoteFile, downloadAllAsZip, type ProcessedFile, type ResizedItem } from '../utils/emoteProcessor';

	function setupEmoteDropzone() {
		const containers = document.querySelectorAll('.dropzone-container');

		containers.forEach((container) => {
			if (container.getAttribute('data-ready') === 'true') return;
			container.setAttribute('data-ready', 'true');

			const dropzone = container.querySelector('.dropzone') as HTMLElement | null;
			const fileInput = container.querySelector('.file-input') as HTMLInputElement | null;
			const dropPrompt = container.querySelector('.drop-prompt') as HTMLElement | null;
			const loader = container.querySelector('.loader') as HTMLElement | null;
			const resultsWrapper = container.querySelector('.results-wrapper') as HTMLElement | null;
			const resultsList = container.querySelector('.results-list') as HTMLElement | null;
			const resultsCount = container.querySelector('.results-count') as HTMLElement | null;
			const btnClear = container.querySelector('.btn-clear') as HTMLElement | null;
			const btnDownloadAll = container.querySelector('.btn-download-all') as HTMLElement | null;

			const platformId = container.getAttribute('data-platform') || 'twitch';
			const lang = container.getAttribute('data-lang') || 'es';

			const platformColors: Record<string, string> = {
				twitch: '#a970ff',
				kick: '#53fc18',
				discord: '#5865f2',
				youtube: '#ff0000',
				'7tv': '#38bdf8',
				bttv: '#f97316'
			};
			const currentAccent = platformColors[platformId] || '#a970ff';

			let processedState: ProcessedFile[] = [];

			if (!dropzone || !fileInput) return;

			// Clic en la dropzone abre el explorador de archivos
			dropzone.addEventListener('click', (e: MouseEvent) => {
				if (e.target !== fileInput) {
					fileInput.click();
				}
			});

			// Drag & drop
			['dragenter', 'dragover'].forEach((evt) => {
				dropzone.addEventListener(evt, (e: Event) => {
					e.preventDefault();
					e.stopPropagation();
					dropzone.classList.add('drag-over');
				});
			});

			['dragleave', 'drop'].forEach((evt) => {
				dropzone.addEventListener(evt, (e: Event) => {
					e.preventDefault();
					e.stopPropagation();
					dropzone.classList.remove('drag-over');
				});
			});

			dropzone.addEventListener('drop', (e: DragEvent) => {
				const files = e.dataTransfer?.files;
				if (files && files.length) {
					handleFiles(files);
				}
			});

			fileInput.addEventListener('change', () => {
				if (fileInput.files && fileInput.files.length) {
					handleFiles(fileInput.files);
				}
			});

			const cropModal = container.querySelector('.crop-modal-overlay') as HTMLElement | null;
			const cropCanvas = container.querySelector('#crop-canvas') as HTMLCanvasElement | null;
			const cropZoomRange = container.querySelector('#crop-zoom-range') as HTMLInputElement | null;
			const btnCropConfirm = container.querySelector('#btn-crop-confirm') as HTMLElement | null;
			const btnCropCancel = container.querySelector('#btn-crop-cancel') as HTMLElement | null;
			const btnCropClose = container.querySelector('#btn-crop-close') as HTMLElement | null;

			const errorToast = container.querySelector('#error-toast') as HTMLElement | null;
			const errorToastTitle = container.querySelector('#error-toast-title') as HTMLElement | null;
			const errorToastDesc = container.querySelector('#error-toast-desc') as HTMLElement | null;
			const errorToastClose = container.querySelector('#error-toast-close') as HTMLElement | null;

			function hideError() {
				if (errorToast) errorToast.style.display = 'none';
			}

			function showError(titleText: string, descText: string) {
				if (errorToast && errorToastTitle && errorToastDesc) {
					errorToastTitle.textContent = titleText;
					errorToastDesc.textContent = descText;
					errorToast.style.display = 'flex';
				}
			}

			errorToastClose?.addEventListener('click', (e: MouseEvent) => {
				e.stopPropagation();
				hideError();
			});

			const validImageExtensions = ['.png', '.jpg', '.jpeg', '.webp', '.gif', '.bmp', '.ico', '.svg', '.tiff', '.tif', '.avif', '.heic', '.heif'];

			function isValidImageFile(file: File): boolean {
				if (file.type && file.type.startsWith('image/')) return true;
				return validImageExtensions.some(ext => file.name.toLowerCase().endsWith(ext));
			}

			async function handleFiles(files: FileList | File[]) {
				if (!files.length) return;
				hideError();

				const fileList = Array.from(files);
				const invalidFiles: string[] = [];
				const validFiles: File[] = [];

				for (const file of fileList) {
					if (!isValidImageFile(file)) {
						invalidFiles.push(file.name);
					} else {
						validFiles.push(file);
					}
				}

				if (invalidFiles.length > 0) {
					const title = lang === 'es' ? 'Formato de archivo no válido' : 'Invalid file format';
					const desc = lang === 'es'
						? `Los siguientes archivos no son imágenes válidas: ${invalidFiles.join(', ')}. Por favor, sube solo archivos de imagen (PNG, JPG, WebP, GIF, SVG, AVIF, HEIC).`
						: `The following files are not valid image files: ${invalidFiles.join(', ')}. Please upload image files only (PNG, JPG, WebP, GIF, SVG, AVIF, HEIC).`;
					showError(title, desc);
				}

				if (!validFiles.length) {
					if (fileInput) fileInput.value = '';
					return;
				}

				for (const file of validFiles) {
					// Incrementar contador global y contador por plataforma en Supabase
					try {
						const { supabase } = await import('../lib/supabase');
						await Promise.all([
							supabase.rpc('increment_counter', { counter_id: 'image_uploads' }),
							supabase.rpc('increment_counter', { counter_id: platformId })
						]);
					} catch (e) {
						// Fallback HTTP REST si el SDK tuviera algún problema de red
						try {
							const headers = {
								'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdGtkc25tY2dwY3dkeWd0cHlpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYxOTQ3OTYsImV4cCI6MjEwMTc3MDc5Nn0.WxRgm7yB-UxNe_kkaf4lk7_etS_9L8FXxLK0EAnS0LM',
								'Content-Type': 'application/json'
							};
							await Promise.all([
								fetch('https://yotkdsnmcgpcwdygtpyi.supabase.co/rest/v1/rpc/increment_counter', {
									method: 'POST',
									headers,
									body: JSON.stringify({ counter_id: 'image_uploads' })
								}),
								fetch('https://yotkdsnmcgpcwdygtpyi.supabase.co/rest/v1/rpc/increment_counter', {
									method: 'POST',
									headers,
									body: JSON.stringify({ counter_id: platformId })
								})
							]);
						} catch (err) {}
					}

					if (typeof window !== 'undefined') {
						window.dispatchEvent(new CustomEvent('counter:incremented'));
					}

					// Evento clave para Google Analytics / Tag Manager
					if (typeof window !== 'undefined') {
						const w = window as any;
						w.dataLayer = w.dataLayer || [];
						w.dataLayer.push({
							event: 'file_upload',
							file_name: file.name,
							file_extension: file.name.split('.').pop()?.toLowerCase() || '',
							file_size: file.size,
							platform: platformId,
							file_count: validFiles.length
						});

						if (typeof w.gtag === 'function') {
							w.gtag('event', 'file_upload', {
								file_name: file.name,
								file_extension: file.name.split('.').pop()?.toLowerCase() || '',
								file_size: file.size,
								platform: platformId,
								file_count: validFiles.length
							});
						}
					}

					showLoader(true);
					const res = await processEmoteFile(file, platformId);
					if (res.error) {
						showError(lang === 'es' ? 'Error de procesamiento' : 'Processing Error', res.error);
					} else {
						processedState.push(res);
					}
				}

				showLoader(false);
				renderResults();
				if (fileInput) fileInput.value = '';
			}

			function checkIfNonSquare(file: File): Promise<boolean> {
				return new Promise((resolve) => {
					if (file.type === 'image/gif' || file.name.toLowerCase().endsWith('.gif')) {
						return resolve(false);
					}
					const img = new Image();
					const url = URL.createObjectURL(file);
					img.onload = () => {
						URL.revokeObjectURL(url);
						const ratio = img.width / img.height;
						resolve(Math.abs(ratio - 1) > 0.05); // No es cuadrada si la relación difiere de 1
					};
					img.onerror = () => {
						URL.revokeObjectURL(url);
						resolve(false);
					};
					img.src = url;
				});
			}

			function openCropModal(file: File): Promise<File | null> {
				return new Promise((resolve) => {
					if (!cropModal || !cropCanvas) return resolve(null);

					cropModal.style.display = 'flex';

					const img = new Image();
					const url = URL.createObjectURL(file);

					let currentZoom = 1;
					if (cropZoomRange) cropZoomRange.value = '1';

					img.onload = () => {
						const ctx = cropCanvas.getContext('2d');
						if (!ctx) return resolve(null);

						cropCanvas.width = 300;
						cropCanvas.height = 300;

						const renderCanvas = () => {
							ctx.clearRect(0, 0, 300, 300);
							const minDim = Math.min(img.width, img.height);
							const cropWidth = minDim / currentZoom;
							const cropHeight = minDim / currentZoom;
							const sx = (img.width - cropWidth) / 2;
							const sy = (img.height - cropHeight) / 2;

							ctx.drawImage(img, sx, sy, cropWidth, cropHeight, 0, 0, 300, 300);
						};

						renderCanvas();

						const handleZoom = () => {
							if (cropZoomRange) {
								currentZoom = parseFloat(cropZoomRange.value);
								renderCanvas();
							}
						};

						cropZoomRange?.addEventListener('input', handleZoom);

						const cleanup = () => {
							URL.revokeObjectURL(url);
							cropModal.style.display = 'none';
							cropZoomRange?.removeEventListener('input', handleZoom);
						};

						const onConfirm = () => {
							cropCanvas.toBlob((blob) => {
								cleanup();
								if (blob) {
									const cropped = new File([blob], file.name, { type: 'image/png' });
									resolve(cropped);
								} else {
									resolve(null);
								}
							}, 'image/png');
						};

						const onCancel = () => {
							cleanup();
							resolve(null);
						};

						btnCropConfirm?.addEventListener('click', onConfirm);
						btnCropCancel?.addEventListener('click', onCancel);
						btnCropClose?.addEventListener('click', onCancel);
					};

					img.src = url;
				});
			}

			function showLoader(loading: boolean) {
				if (dropPrompt && loader) {
					dropPrompt.style.display = loading ? 'none' : 'flex';
					loader.style.display = loading ? 'flex' : 'none';
				}
			}

			function renderResults() {
				if (!resultsWrapper || !resultsList) return;

				if (processedState.length === 0) {
					resultsWrapper.style.display = 'none';
					resultsList.innerHTML = '';
					if (fileInput) fileInput.value = '';
					setTimeout(() => {
						dropzone?.scrollIntoView({ behavior: 'smooth', block: 'center' });
					}, 50);
					return;
				}

				resultsWrapper.style.display = 'flex';
				resultsList.innerHTML = '';

				// Desplazamiento suave automático hacia los resultados
				setTimeout(() => {
					resultsWrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}, 50);

				processedState.forEach((pf: ProcessedFile) => {
					const fileContainer = document.createElement('div');
					fileContainer.className = 'file-result-container';

					// Agrupar elementos por categoría (EMOTES, BADGES, etc.)
					const categories: Record<string, ResizedItem[]> = {};
					pf.items.forEach((item) => {
						const cat = item.category || 'EMOTES';
						if (!categories[cat]) categories[cat] = [];
						categories[cat].push(item);
					});

					Object.keys(categories).forEach((catName) => {
						const categoryBlock = document.createElement('div');
						categoryBlock.className = 'category-block';

						const categoryTitle = document.createElement('div');
						categoryTitle.className = 'category-title';
						categoryTitle.textContent = catName;
						categoryBlock.appendChild(categoryTitle);

						const grid = document.createElement('div');
						grid.className = 'items-grid';

						categories[catName].forEach((item: ResizedItem) => {
							const itemCard = document.createElement('div');
							itemCard.className = 'item-card';

							const formattedSize = item.blob.size > 1024 * 1024
								? `${(item.blob.size / (1024 * 1024)).toFixed(2)}MB`
								: `${(item.blob.size / 1024).toFixed(2)}KB`;

							itemCard.innerHTML = `
								<div class="card-preview-area">
									<img src="${item.previewUrl}" alt="${item.name}" width="${item.width}" height="${item.height}" />
								</div>
								<div class="card-meta-bar">
									<span class="item-dim">${item.width}px x ${item.height}px</span>
									<span class="item-size">${formattedSize}</span>
								</div>
							`;

							itemCard.addEventListener('click', () => {
								const a = document.createElement('a');
								a.href = item.previewUrl;
								a.download = item.name;
								document.body.appendChild(a);
								a.click();
								document.body.removeChild(a);
							});

							grid.appendChild(itemCard);
						});

						categoryBlock.appendChild(grid);
						fileContainer.appendChild(categoryBlock);
					});

					resultsList.appendChild(fileContainer);
				});
			}

			btnClear?.addEventListener('click', (e: MouseEvent) => {
				e.stopPropagation();
				processedState = [];
				if (fileInput) fileInput.value = '';
				renderResults();
			});

			btnDownloadAll?.addEventListener('click', (e: MouseEvent) => {
				e.stopPropagation();
				if (processedState.length) {
					downloadAllAsZip(processedState, `sizeGG-${platformId}-emotes.zip`);
				}
			});
		});
	}

	setupEmoteDropzone();
	document.addEventListener('astro:page-load', setupEmoteDropzone);
</script>
