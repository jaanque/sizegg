---
export interface Props {
	lang: 'es' | 'en';
	platformId: 'twitch' | 'kick' | 'discord' | 'youtube' | '7tv' | 'bttv';
	accentColor?: string;
}

const { lang, platformId, accentColor = '#a970ff' } = Astro.props;

const labels = {
	es: {
		dragTitle: 'Arrastra y suelta tus emotes aquí',
		dragOr: 'o selecciona archivos desde tu ordenador',
		uploading: 'Procesando imágenes...',
		downloadAll: 'Descargar todos (.ZIP)',
		downloadSingle: 'Descargar',
		clearAll: 'Limpiar lista',
		filesProcessed: 'archivos procesados',
		invalidFile: 'Formato no compatible',
		specs: {
			twitch: 'Redimensiona automáticamente a 112×112, 56×56 y 28×28 px',
			kick: 'Formato Kick: 500×500 px (Máx 1 MB)',
			discord: 'Tamaño recomendado Discord: 128×128 px (Máx 256 KB)',
			youtube: 'Formato YouTube: 480×480 px (Máx 1 MB)',
			'7tv': 'Soporta 128×128 px y formato WebP (Máx 5 MB)',
			bttv: 'Soporta 112×112, 56×56 y 28×28 px (Máx 3 MB)'
		}
	},
	en: {
		dragTitle: 'Drag and drop your emotes here',
		dragOr: 'or select files from your computer',
		uploading: 'Processing images...',
		downloadAll: 'Download All (.ZIP)',
		downloadSingle: 'Download',
		clearAll: 'Clear list',
		filesProcessed: 'files processed',
		invalidFile: 'Unsupported format',
		specs: {
			twitch: 'Auto-resizes to 112×112, 56×56 & 28×28 px',
			kick: 'Kick format: 500×500 px (Max 1 MB)',
			discord: 'Recommended Discord size: 128×128 px (Max 256 KB)',
			youtube: 'YouTube format: 480×480 px (Max 1 MB)',
			'7tv': 'Supports 128×128 px & WebP format (Max 5 MB)',
			bttv: 'Supports 112×112, 56×56 & 28×28 px (Max 3 MB)'
		}
	}
};

const t = labels[lang];
const specText = t.specs[platformId] || t.specs.twitch;
---

<div class="dropzone-container" data-platform={platformId} data-lang={lang}>
	<div class="dropzone" style={`--accent-color: ${accentColor};`}>
		<input type="file" class="file-input" multiple accept="image/png,image/jpeg,image/jpg,image/webp,image/gif,image/bmp" style="display: none;" />
		
		<div class="drop-prompt" id="drop-prompt">
			<div class="icon-box">
				<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
					<polyline points="17 8 12 3 7 8"></polyline>
					<line x1="12" y1="3" x2="12" y2="15"></line>
				</svg>
			</div>
			<div class="prompt-text">
				<h2>{t.dragTitle}</h2>
				<p>{t.dragOr}</p>
			</div>
			<div class="specs-pill">{specText}</div>
		</div>

		<div class="loader" id="loader" style="display: none;">
			<div class="spinner"></div>
			<p>{t.uploading}</p>
		</div>
	</div>

	<!-- Modal Interactivo de Recorte / Ajuste (Crop Modal) -->
	<div class="crop-modal-overlay" id="crop-modal" style="display: none;">
		<div class="crop-modal-content">
			<div class="crop-modal-header">
				<div class="crop-modal-title">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M6 2v14a2 2 0 0 0 2 2h14"></path>
						<path d="M18 22V8a2 2 0 0 0-2-2H2"></path>
					</svg>
					<span>{lang === 'es' ? 'Recorte Cuadrado (1:1)' : 'Square Crop (1:1)'}</span>
				</div>
				<button class="btn-crop-close" id="btn-crop-close">&times;</button>
			</div>

			<div class="crop-modal-body">
				<p class="crop-instructions">
					{lang === 'es' 
						? 'Tu imagen no es cuadrada. Ajusta y centra el encuadre (1:1) antes de procesarla.' 
						: 'Your image is not square. Adjust and center the (1:1) crop frame before processing.'}
				</p>
				<div class="crop-canvas-wrapper">
					<canvas id="crop-canvas"></canvas>
				</div>
				<div class="crop-controls">
					<label>{lang === 'es' ? 'Zoom y Encuadre:' : 'Zoom & Frame:'}</label>
					<input type="range" id="crop-zoom-range" min="1" max="3" step="0.05" value="1" />
				</div>
			</div>

			<div class="crop-modal-footer">
				<button class="btn-crop-cancel" id="btn-crop-cancel">{lang === 'es' ? 'Omitir' : 'Skip'}</button>
				<button class="btn-crop-confirm" id="btn-crop-confirm" style={`--accent-color: ${accentColor};`}>
					{lang === 'es' ? 'Aplicar Recorte y Procesar' : 'Apply Crop & Process'}
				</button>
			</div>
		</div>
	</div>

	<!-- Resultados e imágenes generadas -->
	<div class="results-wrapper" id="results-wrapper" style="display: none;">
		<div class="results-header">
			<span class="results-count" id="results-count">0 {t.filesProcessed}</span>
			<div class="results-actions">
				<button class="btn-clear" id="btn-clear">{t.clearAll}</button>
				<button class="btn-download-all" id="btn-download-all" style={`--accent-color: ${accentColor};`}>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
						<polyline points="7 10 12 15 17 10"></polyline>
						<line x1="12" y1="15" x2="12" y2="3"></line>
					</svg>
					<span>{t.downloadAll}</span>
				</button>
			</div>
		</div>

		<div class="results-list" id="results-list"></div>
	</div>
</div>

<style>
	.dropzone-container {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		box-sizing: border-box;
	}

	.dropzone {
		width: 100%;
		min-height: 340px;
		background-color: var(--surface-card);
		border: 2px dashed var(--border-color);
		border-radius: 12px;
		padding: 3.25rem 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		box-sizing: border-box;
		transition: border-color 0.2s ease, background-color 0.2s ease;
	}

	.dropzone:hover {
		border-color: var(--accent-color);
		background-color: var(--surface-hover);
	}

	.dropzone.drag-over {
		border-color: var(--accent-color);
		border-style: solid;
		background-color: rgba(255, 255, 255, 0.03);
	}

	.drop-prompt {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		text-align: center;
		pointer-events: none;
	}

	.icon-box {
		width: 52px;
		height: 52px;
		border-radius: 10px;
		background-color: var(--surface-hover);
		border: 1px solid var(--border-color);
		color: var(--accent-color);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.prompt-text h2 {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.2rem;
	}

	.prompt-text p {
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	.specs-pill {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--text-muted);
		background-color: var(--bg-body);
		padding: 0.35rem 0.75rem;
		border-radius: 6px;
		border: 1px solid var(--border-color);
	}

	/* Loader */
	.loader {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		color: var(--text-muted);
		font-size: 0.9rem;
		font-weight: 600;
	}

	.spinner {
		width: 32px;
		height: 32px;
		border: 3px solid var(--border-color);
		border-top-color: var(--accent-color);
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	@keyframes spin {
		to { transform: rotate(360deg); }
	}

	/* Resultados */
	.results-wrapper {
		background-color: var(--surface-card);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.results-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--border-color);
	}

	.results-count {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--text-muted);
	}

	.results-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.btn-clear {
		background: transparent;
		border: 1px solid var(--border-color);
		color: var(--text-muted);
		font-family: inherit;
		font-size: 0.8rem;
		font-weight: 600;
		padding: 0.4rem 0.75rem;
		border-radius: 6px;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-clear:hover {
		color: var(--text-primary);
		background-color: var(--surface-hover);
	}

	.btn-download-all {
		background-color: var(--accent-color);
		border: none;
		color: #000000;
		font-family: inherit;
		font-size: 0.8rem;
		font-weight: 700;
		padding: 0.45rem 0.85rem;
		border-radius: 6px;
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		transition: opacity 0.15s ease;
	}

	.btn-download-all:hover {
		opacity: 0.9;
	}

	.results-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	:global(.file-result-card) {
		background-color: var(--surface-card);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	:global(.file-result-header) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--border-color);
		gap: 0.5rem;
	}

	:global(.file-result-title) {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--text-primary);
		word-break: break-all;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	:global(.file-result-actions) {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	:global(.btn-file-action) {
		background: var(--surface-hover);
		border: 1px solid var(--border-color);
		color: var(--text-primary);
		font-family: inherit;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.3rem 0.6rem;
		border-radius: 6px;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		transition: all 0.15s ease;
	}

	:global(.btn-file-action:hover) {
		border-color: var(--text-muted);
		background-color: var(--border-color);
	}

	:global(.btn-file-action.delete) {
		color: #ff4f4d;
		border-color: rgba(255, 79, 77, 0.2);
		background: rgba(255, 79, 77, 0.05);
	}

	:global(.btn-file-action.delete:hover) {
		border-color: #ff4f4d;
		background: rgba(255, 79, 77, 0.15);
	}

	:global(.result-body-layout) {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
		align-items: start;
	}

	@media (max-width: 680px) {
		:global(.result-body-layout) {
			grid-template-columns: 1fr;
		}
	}

	:global(.result-section-title) {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin-bottom: 0.6rem;
	}

	:global(.items-grid) {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
		gap: 0.6rem;
	}

	:global(.item-card) {
		background-color: var(--bg-body);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 0.75rem 0.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		text-align: center;
	}

	:global(.preview-box) {
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: repeating-conic-gradient(rgba(255, 255, 255, 0.05) 0% 25%, transparent 0% 50%) 50% / 12px 12px;
		border-radius: 6px;
		border: 1px solid var(--border-color);
		overflow: hidden;
	}

	:global(.preview-box img) {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}

	:global(.item-info) {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	:global(.item-dim) {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--text-primary);
	}

	:global(.item-size) {
		font-size: 0.68rem;
		color: var(--text-muted);
	}

	:global(.btn-download-single) {
		width: 100%;
		background: var(--surface-hover);
		border: 1px solid var(--border-color);
		color: var(--text-primary);
		font-family: inherit;
		font-size: 0.72rem;
		font-weight: 600;
		padding: 0.3rem 0.4rem;
		border-radius: 4px;
		cursor: pointer;
		text-decoration: none;
		text-align: center;
		display: inline-block;
		box-sizing: border-box;
		transition: all 0.15s ease;
	}

	:global(.btn-download-single:hover) {
		border-color: var(--text-muted);
		background: var(--border-color);
	}

	/* Estilos Modal de Recorte Cuadrado (Crop Modal) */
	.crop-modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.75);
		backdrop-filter: blur(4px);
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.crop-modal-content {
		background-color: var(--surface-card);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		width: 100%;
		max-width: 440px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
	}

	.crop-modal-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.25rem;
		border-bottom: 1px solid var(--border-color);
	}

	.crop-modal-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text-primary);
	}

	.btn-crop-close {
		background: none;
		border: none;
		color: var(--text-muted);
		font-size: 1.5rem;
		cursor: pointer;
		line-height: 1;
	}

	.btn-crop-close:hover {
		color: var(--text-primary);
	}

	.crop-modal-body {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.crop-instructions {
		font-size: 0.8rem;
		color: var(--text-muted);
		text-align: center;
		margin: 0;
	}

	.crop-canvas-wrapper {
		width: 240px;
		height: 240px;
		background: repeating-conic-gradient(rgba(255, 255, 255, 0.05) 0% 25%, transparent 0% 50%) 50% / 16px 16px;
		border: 2px dashed var(--accent-color, #a970ff);
		border-radius: 8px;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	#crop-canvas {
		display: block;
		cursor: grab;
	}

	#crop-canvas:active {
		cursor: grabbing;
	}

	.crop-controls {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: 0.75rem;
		color: var(--text-primary);
		font-weight: 600;
	}

	.crop-controls input[type="range"] {
		width: 100%;
		accent-color: var(--accent-color, #a970ff);
	}

	.crop-modal-footer {
		padding: 0.85rem 1.25rem;
		background-color: var(--bg-body);
		border-top: 1px solid var(--border-color);
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
	}

	.btn-crop-cancel {
		background: transparent;
		border: 1px solid var(--border-color);
		color: var(--text-muted);
		padding: 0.45rem 0.85rem;
		border-radius: 6px;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
	}

	.btn-crop-cancel:hover {
		color: var(--text-primary);
		border-color: var(--text-muted);
	}

	.btn-crop-confirm {
		background: var(--accent-color, #a970ff);
		border: none;
		color: #fff;
		padding: 0.45rem 1rem;
		border-radius: 6px;
		font-size: 0.8rem;
		font-weight: 700;
		cursor: pointer;
		transition: opacity 0.15s ease;
	}

	.btn-crop-confirm:hover {
		opacity: 0.9;
	}

	:global(.chat-simulator-box) {
		background-color: var(--bg-body);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 0.85rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		width: 100%;
		box-sizing: border-box;
	}

	:global(.chat-sim-header) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--text-muted);
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 0.4rem;
	}

	:global(.chat-sim-title) {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--text-primary);
	}

	:global(.chat-sim-live-badge) {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		color: #ff4f4d;
		font-weight: 800;
		font-size: 0.65rem;
		background: rgba(255, 79, 77, 0.1);
		padding: 0.1rem 0.35rem;
		border-radius: 3px;
	}

	:global(.chat-sim-live-dot) {
		width: 5px;
		height: 5px;
		background-color: #ff4f4d;
		border-radius: 50%;
	}

	:global(.chat-sim-messages) {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		font-size: 0.82rem;
		font-family: Inter, system-ui, -apple-system, sans-serif;
	}

	:global(.chat-msg-row) {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		line-height: 1.4;
		padding: 0.15rem 0.25rem;
		border-radius: 4px;
	}

	:global(.chat-user-badge) {
		padding: 0.08rem 0.28rem;
		border-radius: 3px;
		font-size: 0.6rem;
		font-weight: 800;
		color: #fff;
		background-color: var(--accent-color, #a970ff);
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	:global(.chat-user-badge.badge-vip) { background-color: #e024b3; color: #fff; }
	:global(.chat-user-badge.badge-sub) { background-color: #00e6cb; color: #000; }
	:global(.chat-user-badge.badge-kick-mod) { background-color: #53fc18; color: #000; }
	:global(.chat-user-badge.badge-kick-sub) { background-color: #16a34a; color: #fff; }
	:global(.chat-user-badge.badge-discord-bot) { background-color: #5865f2; color: #fff; }
	:global(.chat-user-badge.badge-discord-nitro) { background-color: #f47fff; color: #000; }
	:global(.chat-user-badge.badge-yt-member) { background-color: #2ba640; color: #fff; }
	:global(.chat-user-badge.badge-yt-mod) { background-color: #065fd4; color: #fff; }
	:global(.chat-user-badge.badge-7tv) { background-color: #38bdf8; color: #000; }
	:global(.chat-user-badge.badge-7tv-pro) { background-color: #0284c7; color: #fff; }
	:global(.chat-user-badge.badge-bttv) { background-color: #f97316; color: #fff; }
	:global(.chat-user-badge.badge-bttv-pro) { background-color: #ea580c; color: #fff; }

	:global(.chat-username) {
		font-weight: 700;
	}

	:global(.chat-username.u1) { color: #0099ff; }
	:global(.chat-username.u2) { color: #00ff7f; }
	:global(.chat-username.u3) { color: #ff69b4; }

	:global(.chat-text) {
		color: #efeff1;
		font-weight: 400;
	}

	:global(.chat-emote-img) {
		height: 24px;
		width: auto;
		max-width: 48px;
		object-fit: contain;
		vertical-align: middle;
		display: inline-block;
		margin: 0 0.1rem;
	}

	:global(.btn-download-single:hover) {
		border-color: var(--text-muted);
		background: var(--border-color);
	}
</style>

<script>
	import { processEmoteFile, downloadAllAsZip, type ProcessedFile, type ResizedItem } from '../utils/emoteProcessor';

	function setupEmoteDropzone() {
		const containers = document.querySelectorAll('.dropzone-container');

		containers.forEach((container) => {
			if (container.getAttribute('data-ready') === 'true') return;
			container.setAttribute('data-ready', 'true');

			const dropzone = container.querySelector('.dropzone') as HTMLElement | null;
			const fileInput = container.querySelector('.file-input') as HTMLInputElement | null;
			const dropPrompt = container.querySelector('.drop-prompt') as HTMLElement | null;
			const loader = container.querySelector('.loader') as HTMLElement | null;
			const resultsWrapper = container.querySelector('.results-wrapper') as HTMLElement | null;
			const resultsList = container.querySelector('.results-list') as HTMLElement | null;
			const resultsCount = container.querySelector('.results-count') as HTMLElement | null;
			const btnClear = container.querySelector('.btn-clear') as HTMLElement | null;
			const btnDownloadAll = container.querySelector('.btn-download-all') as HTMLElement | null;

			const platformId = container.getAttribute('data-platform') || 'twitch';
			const lang = container.getAttribute('data-lang') || 'es';

			let processedState: ProcessedFile[] = [];

			if (!dropzone || !fileInput) return;

			// Clic abre el explorador
			dropzone.addEventListener('click', (e: MouseEvent) => {
				if (e.target !== fileInput) {
					fileInput.click();
				}
			});

			// Drag & drop
			['dragenter', 'dragover'].forEach((evt) => {
				dropzone.addEventListener(evt, (e: Event) => {
					e.preventDefault();
					e.stopPropagation();
					dropzone.classList.add('drag-over');
				});
			});

			['dragleave', 'drop'].forEach((evt) => {
				dropzone.addEventListener(evt, (e: Event) => {
					e.preventDefault();
					e.stopPropagation();
					dropzone.classList.remove('drag-over');
				});
			});

			dropzone.addEventListener('drop', (e: DragEvent) => {
				const files = e.dataTransfer?.files;
				if (files && files.length) {
					handleFiles(files);
				}
			});

			fileInput.addEventListener('change', () => {
				if (fileInput.files && fileInput.files.length) {
					handleFiles(fileInput.files);
				}
			});

			const cropModal = container.querySelector('.crop-modal-overlay') as HTMLElement | null;
			const cropCanvas = container.querySelector('#crop-canvas') as HTMLCanvasElement | null;
			const cropZoomRange = container.querySelector('#crop-zoom-range') as HTMLInputElement | null;
			const btnCropConfirm = container.querySelector('#btn-crop-confirm') as HTMLElement | null;
			const btnCropCancel = container.querySelector('#btn-crop-cancel') as HTMLElement | null;
			const btnCropClose = container.querySelector('#btn-crop-close') as HTMLElement | null;

			async function handleFiles(files: FileList | File[]) {
				if (!files.length) return;

				const fileList = Array.from(files);

				for (const file of fileList) {
					// Comprobar si la imagen es rectangular (relación de aspecto diferente a 1:1)
					const isNonSquare = await checkIfNonSquare(file);

					if (isNonSquare && cropModal && cropCanvas) {
						showLoader(false);
						const croppedFile = await openCropModal(file);
						showLoader(true);
						const res = await processEmoteFile(croppedFile || file, platformId);
						processedState.push(res);
					} else {
						showLoader(true);
						const res = await processEmoteFile(file, platformId);
						processedState.push(res);
					}
				}

				showLoader(false);
				renderResults();
			}

			function checkIfNonSquare(file: File): Promise<boolean> {
				return new Promise((resolve) => {
					if (file.type === 'image/gif' || file.name.toLowerCase().endsWith('.gif')) {
						return resolve(false);
					}
					const img = new Image();
					const url = URL.createObjectURL(file);
					img.onload = () => {
						URL.revokeObjectURL(url);
						const ratio = img.width / img.height;
						resolve(Math.abs(ratio - 1) > 0.05); // No es cuadrada si la relación difiere de 1
					};
					img.onerror = () => {
						URL.revokeObjectURL(url);
						resolve(false);
					};
					img.src = url;
				});
			}

			function openCropModal(file: File): Promise<File | null> {
				return new Promise((resolve) => {
					if (!cropModal || !cropCanvas) return resolve(null);

					cropModal.style.display = 'flex';

					const img = new Image();
					const url = URL.createObjectURL(file);

					let currentZoom = 1;
					if (cropZoomRange) cropZoomRange.value = '1';

					img.onload = () => {
						const ctx = cropCanvas.getContext('2d');
						if (!ctx) return resolve(null);

						cropCanvas.width = 300;
						cropCanvas.height = 300;

						const renderCanvas = () => {
							ctx.clearRect(0, 0, 300, 300);
							const minDim = Math.min(img.width, img.height);
							const cropWidth = minDim / currentZoom;
							const cropHeight = minDim / currentZoom;
							const sx = (img.width - cropWidth) / 2;
							const sy = (img.height - cropHeight) / 2;

							ctx.drawImage(img, sx, sy, cropWidth, cropHeight, 0, 0, 300, 300);
						};

						renderCanvas();

						const handleZoom = () => {
							if (cropZoomRange) {
								currentZoom = parseFloat(cropZoomRange.value);
								renderCanvas();
							}
						};

						cropZoomRange?.addEventListener('input', handleZoom);

						const cleanup = () => {
							URL.revokeObjectURL(url);
							cropModal.style.display = 'none';
							cropZoomRange?.removeEventListener('input', handleZoom);
						};

						const onConfirm = () => {
							cropCanvas.toBlob((blob) => {
								cleanup();
								if (blob) {
									const cropped = new File([blob], file.name, { type: 'image/png' });
									resolve(cropped);
								} else {
									resolve(null);
								}
							}, 'image/png');
						};

						const onCancel = () => {
							cleanup();
							resolve(null);
						};

						btnCropConfirm?.addEventListener('click', onConfirm);
						btnCropCancel?.addEventListener('click', onCancel);
						btnCropClose?.addEventListener('click', onCancel);
					};

					img.src = url;
				});
			}

			function showLoader(loading: boolean) {
				if (dropPrompt && loader) {
					dropPrompt.style.display = loading ? 'none' : 'flex';
					loader.style.display = loading ? 'flex' : 'none';
				}
			}

			function renderResults() {
				if (!resultsWrapper || !resultsList || !resultsCount) return;

				if (processedState.length === 0) {
					resultsWrapper.style.display = 'none';
					resultsList.innerHTML = '';
