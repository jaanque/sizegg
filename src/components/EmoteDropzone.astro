				resultsWrapper.style.display = 'flex';
				resultsCount.textContent = `${processedState.length} ${lang === 'es' ? 'archivos procesados' : 'files processed'}`;
				resultsList.innerHTML = '';

				processedState.forEach((pf: ProcessedFile, pfIndex: number) => {
					const fileCard = document.createElement('div');
					fileCard.className = 'file-result-card';

					const header = document.createElement('div');
					header.className = 'file-result-header';
					
					const title = document.createElement('div');
					title.className = 'file-result-title';
					title.innerHTML = `<span>📁</span><span>${pf.file.name}</span>`;

					const actions = document.createElement('div');
					actions.className = 'file-result-actions';

					// Botón de descargar pack de esta imagen
					const btnPack = document.createElement('button');
					btnPack.className = 'btn-file-action';
					btnPack.title = lang === 'es' ? 'Descargar pack (.ZIP)' : 'Download pack (.ZIP)';
					btnPack.innerHTML = `
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
							<polyline points="7 10 12 15 17 10"></polyline>
							<line x1="12" y1="15" x2="12" y2="3"></line>
						</svg>
						<span>${lang === 'es' ? 'Descargar pack' : 'Download pack'}</span>
					`;
					btnPack.addEventListener('click', (e: MouseEvent) => {
						e.stopPropagation();
						const baseName = pf.file.name.replace(/\.[^/.]+$/, '');
						downloadAllAsZip([pf], `sizeGG-${platformId}-${baseName}.zip`);
					});

					// Botón de borrar esta imagen
					const btnDel = document.createElement('button');
					btnDel.className = 'btn-file-action delete';
					btnDel.title = lang === 'es' ? 'Eliminar imagen' : 'Remove image';
					btnDel.innerHTML = `
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="3 6 5 6 21 6"></polyline>
							<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
						</svg>
					`;
					btnDel.addEventListener('click', (e: MouseEvent) => {
						e.stopPropagation();
						processedState.splice(pfIndex, 1);
						renderResults();
					});

					actions.appendChild(btnPack);
					actions.appendChild(btnDel);

					header.appendChild(title);
					header.appendChild(actions);
					fileCard.appendChild(header);

					const bodyLayout = document.createElement('div');
					bodyLayout.className = 'result-body-layout';

					// Columna Izquierda: Rejilla de salidas redimensionadas
					const colOutputs = document.createElement('div');
					colOutputs.className = 'result-col';
					
					const titleOutputs = document.createElement('div');
					titleOutputs.className = 'result-section-title';
					titleOutputs.textContent = lang === 'es' ? 'Archivos Generados' : 'Generated Files';
					colOutputs.appendChild(titleOutputs);

					const grid = document.createElement('div');
					grid.className = 'items-grid';

					pf.items.forEach((item: ResizedItem) => {
						const itemCard = document.createElement('div');
						itemCard.className = 'item-card';

						const formattedSize = item.blob.size > 1024 * 1024
							? `${(item.blob.size / (1024 * 1024)).toFixed(2)} MB`
