								user1: 'KickKing',
								user1Color: '#53fc18',
								user2: 'GreenVibes',
								user2Color: '#53fc18',
								user3: 'Sarah_Kick',
								user3Color: '#ffffff',
								msg1Es: '¡Nuevo emote de Kick en el chat!',
								msg1En: 'New Kick emote in the chat!',
								msg3Es: '¡Top 1 en Kick! 🔥',
								msg3En: 'Top 1 on Kick! 🔥',
								headerIcon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h18v18H3V3zm3 3v12h3.5v-4.5L13 18h4.5l-4.5-6L17.5 6H13l-3.5 4.5V6H6z"/></svg>`
							},
							discord: {
								title: '#general - Discord',
								badge1: 'BOT',
								badge1Class: 'badge-discord-bot',
								badge2: 'NITRO',
								badge2Class: 'badge-discord-nitro',
								user1: 'DiscordAdmin',
								user1Color: '#5865f2',
								user2: 'ServerMember',
