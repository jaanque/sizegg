						itemCard.innerHTML = `
							<div class="preview-box">
								<img src="${item.previewUrl}" alt="${item.name}" />
							</div>
							<div class="item-info">
								<span class="item-dim">${item.width} × ${item.height} px</span>
								<span class="item-size">${formattedSize}</span>
							</div>
						`;

						const btnDL = document.createElement('a');
						btnDL.className = 'btn-download-single';
						btnDL.href = item.previewUrl;
						btnDL.download = item.name;
						btnDL.textContent = lang === 'es' ? 'Descargar' : 'Download';

						itemCard.appendChild(btnDL);
						grid.appendChild(itemCard);
