---
export interface Props {
	slot?: string;
	style?: string;
	format?: string;
	responsive?: string;
	className?: string;
}

const {
	slot = '1618784092',
	style = 'display:block',
	format = 'auto',
	responsive = 'true',
	className = ''
} = Astro.props;
---

<div class={`ad-banner-wrapper ${className}`}>
	<!-- sizegg.com -->
	<ins class="adsbygoogle"
	     style={style}
	     data-ad-client="ca-pub-7810270628851034"
	     data-ad-slot={slot}
	     data-ad-format={format}
	     data-full-width-responsive={responsive}></ins>
	<script is:inline>
	     (adsbygoogle = window.adsbygoogle || []).push({});
	</script>
</div>

<style>
	.ad-banner-wrapper {
		width: 100%;
		min-height: 90px;
		display: flex;
		justify-content: center;
		align-items: center;
		margin: 1.5rem 0;
		overflow: hidden;
	}
</style>
