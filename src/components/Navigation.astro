---
export interface Props {
	lang: 'es' | 'en';
	platform?: 'twitch' | 'kick' | 'discord' | 'youtube' | '7tv' | 'bttv';
}

const { lang, platform } = Astro.props;

const slugMap: Record<'es' | 'en', Record<string, string>> = {
	es: {
		twitch: 'redimensionar-emotes-twitch',
		kick: 'redimensionar-emotes-kick',
		discord: 'redimensionar-emotes-discord',
		youtube: 'redimensionar-emotes-youtube',
		'7tv': 'redimensionar-emotes-7tv',
		bttv: 'redimensionar-emotes-bttv',
	},
	en: {
		twitch: 'twitch-emote-resizer',
		kick: 'kick-emote-resizer',
		discord: 'discord-emote-resizer',
		youtube: 'youtube-emote-resizer',
		'7tv': '7tv-emote-resizer',
		bttv: 'bttv-emote-resizer',
	}
};

const mainPlatforms = [
	{
		id: 'twitch',
		name: 'Twitch',
		svg: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M11.571 4.714h1.715v5.143H11.571zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/></svg>`
	},
	{
		id: 'kick',
		name: 'Kick',
		svg: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h4v6.5L13.5 3H19l-7.2 8.5L19.5 21h-5.6L8 13.5V21H3V3z"/></svg>`
	},
	{
		id: 'discord',
		name: 'Discord',
		svg: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>`
	}
];

const secondaryPlatforms = [
	{
		id: 'youtube',
		name: 'YouTube',
		svg: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`
	},
	{
		id: '7tv',
		name: '7TV',
		svg: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M2 4h20v3H9l-5 13H1v-3l3-10H2V4zm7 6h13v3H13l-4 10H6v-3l3-10z"/></svg>`
	},
	{
		id: 'bttv',
		name: 'BTTV',
		svg: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8.293 2.293a1 1 0 0 1 1.414 0L12 4.586l2.293-2.293a1 1 0 1 1 1.414 1.414L13.414 6H18a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4v-8a4 4 0 0 1 4-4h4.586L8.293 3.707a1 1 0 0 1 0-1.414zM6 8a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2H6zm2.5 3a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zm7 0a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zm-6.25 4.5a.75.75 0 0 1 .75-.75h4a.75.75 0 0 1 0 1.5h-4a.75.75 0 0 1-.75-.75z"/></svg>`
	}
];

const platformColors: Record<string, { accent: string; bg: string; border: string }> = {
	twitch: { accent: '#a970ff', bg: 'rgba(169, 112, 255, 0.1)', border: 'rgba(169, 112, 255, 0.3)' },
	kick: { accent: '#53fc18', bg: 'rgba(83, 252, 24, 0.1)', border: 'rgba(83, 252, 24, 0.3)' },
	discord: { accent: '#5865f2', bg: 'rgba(88, 101, 242, 0.1)', border: 'rgba(88, 101, 242, 0.3)' },
	youtube: { accent: '#ff0000', bg: 'rgba(255, 0, 0, 0.1)', border: 'rgba(255, 0, 0, 0.3)' },
	'7tv': { accent: '#38bdf8', bg: 'rgba(56, 189, 248, 0.1)', border: 'rgba(56, 189, 248, 0.3)' },
	bttv: { accent: '#f97316', bg: 'rgba(249, 115, 22, 0.1)', border: 'rgba(249, 115, 22, 0.3)' }
};

const currentTheme = platform && platformColors[platform] ? platformColors[platform] : platformColors.twitch;

const isSecondaryActive = secondaryPlatforms.some(p => p.id === platform);
const moreLabel = lang === 'es' ? 'Más' : 'More';
const targetLang = lang === 'es' ? 'en' : 'es';
const targetSlug = platform ? slugMap[targetLang][platform] : '';
const targetLangUrl = `/${targetLang}${targetSlug ? `/${targetSlug}` : ''}`;
---

<nav class="platform-nav">
	<a href={`/${lang}`} class="nav-logo-tag" style={`--logo-accent: ${currentTheme.accent}; --logo-bg: ${currentTheme.bg}; --logo-border: ${currentTheme.border};`} title="sizeGG Home">
		sizeGG
	</a>

	<div class="nav-links-right">
		{mainPlatforms.map(p => (
			<a href={`/${lang}/${slugMap[lang][p.id]}`} class={`nav-tab ${platform === p.id ? 'active' : ''}`}>
				<span class="tab-icon" set:html={p.svg} />
				<span>{p.name}</span>
			</a>
		))}

		<!-- Desplegable para plataformas secundarias -->
		<div class="dropdown-wrapper" id="platforms-dropdown-wrapper">
			<button class={`dropdown-btn ${isSecondaryActive ? 'active' : ''}`} id="more-platforms-btn">
				<span>{moreLabel}</span>
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="m6 9 6 6 6-6"/>
				</svg>
			</button>

			<div class="dropdown-menu">
				{secondaryPlatforms.map(p => (
					<a href={`/${lang}/${slugMap[lang][p.id]}`} class={`dropdown-item ${platform === p.id ? 'active' : ''}`}>
						<span class="tab-icon" set:html={p.svg} />
						<span>{p.name}</span>
					</a>
				))}
			</div>
		</div>

		<!-- Desplegable de Selector de Idioma -->
		<div class="dropdown-wrapper" id="lang-dropdown-wrapper">
			<button class="dropdown-btn lang-btn" id="lang-btn">
				<span>{lang.toUpperCase()}</span>
				<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="m6 9 6 6 6-6"/>
				</svg>
			</button>

			<div class="dropdown-menu lang-menu">
				<a href={`/es${platform ? `/${slugMap.es[platform]}` : ''}`} class={`dropdown-item ${lang === 'es' ? 'active' : ''}`} data-set-lang="es">
					<span>Español</span>
				</a>
				<a href={`/en${platform ? `/${slugMap.en[platform]}` : ''}`} class={`dropdown-item ${lang === 'en' ? 'active' : ''}`} data-set-lang="en">
					<span>English</span>
				</a>
			</div>
		</div>
	</div>
</nav>

<style>
	.platform-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
	}

	.nav-links-right {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-wrap: wrap;
	}

	.nav-logo-tag {
		font-size: 0.88rem;
		font-weight: 800;
		color: var(--logo-accent);
		background-color: var(--logo-bg);
		border: 1px solid var(--logo-border);
		padding: 0.32rem 0.75rem;
		border-radius: 20px;
		text-decoration: none;
		margin-right: 0.35rem;
		letter-spacing: -0.01em;
		display: inline-flex;
		align-items: center;
		transition: all 0.2s ease;
	}

	.nav-logo-tag:hover {
		border-color: var(--logo-accent);
		box-shadow: 0 0 12px var(--logo-bg);
	}

	.nav-tab {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.45rem 0.75rem;
		border-radius: 6px;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-muted);
		text-decoration: none;
		border: 1px solid transparent;
		transition: all 0.15s ease;
	}

	.nav-tab:hover {
		color: var(--text-primary);
		background-color: var(--surface-hover);
	}

	.nav-tab.active {
		color: var(--text-primary);
		background-color: var(--surface-hover);
		border-color: var(--border-color);
	}

	.tab-icon {
		display: flex;
		align-items: center;
	}

	/* Estilos generales de desplegables */
	.dropdown-wrapper {
		position: relative;
	}

	.dropdown-btn {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem 0.65rem;
		border-radius: 6px;
		font-family: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-muted);
		background: transparent;
		border: 1px solid transparent;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.dropdown-btn:hover,
	.dropdown-btn.active {
		color: var(--text-primary);
		background-color: var(--surface-hover);
		border-color: var(--border-color);
	}

	.dropdown-menu {
		position: absolute;
		top: calc(100% + 0.35rem);
		right: 0;
		min-width: 120px;
		background-color: var(--surface-card);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 0.35rem;
		display: none;
		flex-direction: column;
		gap: 0.25rem;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
		z-index: 50;
	}

	.dropdown-wrapper.open .dropdown-menu {
		display: flex;
	}

	.dropdown-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 0.65rem;
		border-radius: 6px;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-muted);
		text-decoration: none;
		transition: all 0.15s ease;
	}

	.dropdown-item:hover,
	.dropdown-item.active {
		color: var(--text-primary);
		background-color: var(--surface-hover);
	}

	.lang-btn {
		margin-left: 0.25rem;
		padding: 0.4rem 0.6rem;
		font-weight: 700;
		background: var(--surface-hover);
		border: 1px solid var(--border-color);
	}

	.lang-menu {
		min-width: 110px;
	}
</style>

<script>
	const langLinks = document.querySelectorAll('[data-set-lang]');
	langLinks.forEach(link => {
		link.addEventListener('click', () => {
			const targetLang = link.getAttribute('data-set-lang');
			if (targetLang) {
				localStorage.setItem('preferred_lang', targetLang);
			}
		});
	});

	const platformsWrapper = document.getElementById('platforms-dropdown-wrapper');
	const platformsBtn = document.getElementById('more-platforms-btn');
	const langWrapper = document.getElementById('lang-dropdown-wrapper');
	const langBtn = document.getElementById('lang-btn');

	if (platformsWrapper && platformsBtn) {
		platformsBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			langWrapper?.classList.remove('open');
			platformsWrapper.classList.toggle('open');
		});
	}

	if (langWrapper && langBtn) {
		langBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			platformsWrapper?.classList.remove('open');
			langWrapper.classList.toggle('open');
		});
	}

	document.addEventListener('click', () => {
		platformsWrapper?.classList.remove('open');
		langWrapper?.classList.remove('open');
	});
</script>
