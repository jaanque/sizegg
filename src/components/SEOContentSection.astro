---
export interface Props {
	lang: 'es' | 'en';
	platformId: 'twitch' | 'kick' | 'discord' | 'youtube' | '7tv' | 'bttv';
}

const { lang, platformId } = Astro.props;

const allImagesTextEs = '.png, .jpg, .jpeg, .webp, .gif, .svg, .bmp, .ico, .avif, .heic, .heif, .tiff, .tif';
const allImagesTextEn = '.png, .jpg, .jpeg, .webp, .gif, .svg, .bmp, .ico, .avif, .heic, .heif, .tiff, .tif';

const platformSpecs: Record<string, {
	name: string;
	sizes: string;
	maxSize: string;
	formats: string;
	allowedInput: string;
	detailsEs: string;
	detailsEn: string;
}> = {
	twitch: {
		name: 'Twitch',
		sizes: '112×112px, 56×56px y 28×28px',
		maxSize: '1 MB',
		formats: 'PNG (estático) / GIF (animado)',
		allowedInput: lang === 'es' ? allImagesTextEs : allImagesTextEn,
		detailsEs: 'Herramienta online gratuita para redimensionar emotes de Twitch en los 3 tamaños oficiales exigidos (112×112px, 56×56px y 28×28px). Nuestro motor de procesamiento por etapas aplica escalado bicúbico de alta densidad con preservación estricta de transparencia alfa (PNG) y velocidad de animación GIF sin borrosidad.',
		detailsEn: 'Free online tool to resize emotes for Twitch into all 3 official required sizes (112×112px, 56×56px, and 28×28px). Our multi-step resampling engine applies high-density bicubic scaling with strict alpha transparency preservation (PNG) and crisp GIF animation frame rates.'
	},
	kick: {
		name: 'Kick',
		sizes: '500×500px',
		maxSize: '1 MB',
		formats: 'PNG / GIF / WebP',
		allowedInput: lang === 'es' ? allImagesTextEs : allImagesTextEn,
		detailsEs: 'Redimensiona y convierte tus imágenes para los emotes de canal en Kick.com a 500×500px. sizeGG ajusta automáticamente la relación de aspecto 1:1 y comprime archivos sin pérdidas por debajo del límite máximo de 1 MB.',
		detailsEn: 'Resize and convert images for Kick.com channel emotes to exact 500×500px specifications. sizeGG automatically adjusts the 1:1 aspect ratio and compresses files losslessly below Kick\'s 1 MB maximum limit.'
	},
	discord: {
		name: 'Discord',
		sizes: '128×128px',
		maxSize: '256 KB',
		formats: 'PNG / GIF / WebP',
		allowedInput: lang === 'es' ? allImagesTextEs : allImagesTextEn,
		detailsEs: 'Redimensionador de emojis y stickers para servidores de Discord. Ajusta cualquier avatar, imagen o meme al formato estándar de 128×128px con optimización automática por debajo de 256 KB.',
		detailsEn: 'Emoji and sticker resizer for Discord servers. Convert and scale any avatar, picture, or meme to the standard 128×128px format with automatic compression below 256 KB.'
	},
	youtube: {
		name: 'YouTube',
		sizes: '480×480px',
		maxSize: '1 MB',
		formats: 'PNG / GIF',
		allowedInput: lang === 'es' ? allImagesTextEs : allImagesTextEn,
		detailsEs: 'Redimensionador de emotes de chat e insignias de lealtad para miembros en YouTube. Convierte tus gráficos a 480×480px en alta resolución manteniendo transparencias en PNG y GIF animado.',
		detailsEn: 'Emote and member loyalty badge resizer for YouTube streams. Converts your graphics to 480×480px high resolution while maintaining transparent PNGs and smooth animated GIFs.'
	},
	'7tv': {
		name: '7TV',
		sizes: '128×128px (escalado 1x-4x)',
		maxSize: '5 MB',
		formats: 'WebP / GIF / PNG',
		allowedInput: lang === 'es' ? allImagesTextEs : allImagesTextEn,
		detailsEs: 'Redimensiona y convierte emotes para la extensión 7TV en resoluciones de 128×128px. Optimizado para WebP y GIF animados con soporte total de transparencia avanzada.',
		detailsEn: 'Resize and convert emotes for the 7TV extension to 128×128px resolutions. Optimized for WebP and animated GIFs with full support for advanced alpha transparency.'
	},
	bttv: {
		name: 'BTTV',
		sizes: '112×112px, 56×56px y 28×28px',
		maxSize: '3 MB',
		formats: 'PNG / GIF / WebP',
		allowedInput: lang === 'es' ? allImagesTextEs : allImagesTextEn,
		detailsEs: 'Generador de emotes para BetterTTV (BTTV). Obtén en 1 clic los 3 formatos oficiales de 112px, 56px y 28px listos para subir a tu panel de creador.',
		detailsEn: 'BetterTTV (BTTV) emote generator. Get all 3 official formats (112px, 56px, and 28px) in 1 click ready for your creator dashboard.'
	}
};

const platformColors: Record<string, string> = {
	twitch: '#a970ff',
	kick: '#53fc18',
	discord: '#5865f2',
	youtube: '#ff0000',
	'7tv': '#38bdf8',
	bttv: '#f97316'
};

const spec = platformSpecs[platformId] || platformSpecs.twitch;
const finalAccentColor = platformColors[platformId] || '#a970ff';

const tableSchema = {
	"@context": "https://schema.org",
	"@type": "Table",
	"about": lang === 'es' ? `Especificaciones técnicas de emotes para ${spec.name}` : `Emote technical specifications for ${spec.name}`,
	"name": lang === 'es' ? `Requisitos oficiales de ${spec.name}` : `Official ${spec.name} Requirements`
};
---

<script type="application/ld+json" set:html={JSON.stringify(tableSchema)} />

<section class="seo-guide-block" style={`--accent-color: ${finalAccentColor};`}>
	<details class="guide-card">
		<summary class="guide-header">
			<div class="header-left">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="guide-icon">
					<circle cx="12" cy="12" r="10"></circle>
					<line x1="12" y1="16" x2="12" y2="12"></line>
					<line x1="12" y1="8" x2="12.01" y2="8"></line>
				</svg>
				<h2 class="guide-title">{lang === 'es' ? `Requisitos, Formatos y Especificaciones para ${spec.name}` : `Requirements, Formats & Specifications for ${spec.name}`}</h2>
			</div>
			<svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="6 9 12 15 18 9"></polyline>
			</svg>
		</summary>

		<div class="guide-body">
			<p class="guide-text">
				{lang === 'es' ? spec.detailsEs : spec.detailsEn}
			</p>

			<div class="specs-list" role="table" aria-label={lang === 'es' ? `Especificaciones de ${spec.name}` : `${spec.name} Specifications`}>
				<div class="spec-row" role="row">
					<span class="spec-label" role="columnheader">{lang === 'es' ? 'Archivos que puedes subir:' : 'Supported upload files:'}</span>
					<span class="spec-value" role="cell"><code>{spec.allowedInput}</code></span>
				</div>
				<div class="spec-row" role="row">
					<span class="spec-label" role="columnheader">{lang === 'es' ? 'Formatos de salida generados:' : 'Generated output formats:'}</span>
					<span class="spec-value" role="cell">{spec.formats}</span>
				</div>
				<div class="spec-row" role="row">
					<span class="spec-label" role="columnheader">{lang === 'es' ? 'Dimensiones oficiales:' : 'Official dimensions:'}</span>
					<span class="spec-value" role="cell">{spec.sizes}</span>
				</div>
				<div class="spec-row" role="row">
					<span class="spec-label" role="columnheader">{lang === 'es' ? 'Peso máximo por imagen:' : 'Max file size:'}</span>
					<span class="spec-value" role="cell">{spec.maxSize}</span>
				</div>
			</div>
		</div>
	</details>
</section>

<style>
	.seo-guide-block {
		width: 100%;
	}

	.guide-card {
		background-color: var(--surface-card);
		border: 1px solid var(--border-color);
		border-radius: 22px;
		width: 100%;
		box-sizing: border-box;
		transition: border-color 0.2s ease, background-color 0.2s ease;
		overflow: hidden;
	}

	.guide-card:hover {
		border-color: var(--accent-color, #a970ff);
		background-color: var(--surface-hover);
	}

	.guide-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.6rem 1.1rem;
		cursor: pointer;
		user-select: none;
		list-style: none;
		width: 100%;
		box-sizing: border-box;
	}

	.guide-header::-webkit-details-marker {
		display: none;
	}

	.header-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.chevron-icon {
		color: var(--text-muted);
		transition: transform 0.2s ease, color 0.2s ease;
		flex-shrink: 0;
	}

	.guide-card:hover .chevron-icon {
		color: var(--accent-color, #a970ff);
	}

	.guide-card[open] .chevron-icon {
		transform: rotate(180deg);
		color: var(--accent-color, #a970ff);
	}

	.guide-body {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 0.75rem 1.1rem 1rem 1.1rem;
		border-top: 1px solid var(--border-color);
	}

	.guide-icon {
		color: var(--accent-color, #a970ff);
		flex-shrink: 0;
	}

	.guide-title {
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--text-primary);
		margin: 0;
	}

	.guide-text {
		font-size: 0.9rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
		text-align: left;
	}

	.specs-list {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--border-color);
	}

	.spec-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		background-color: var(--bg-body);
		padding: 0.65rem 0.85rem;
		border-radius: 22px;
		border: 1px solid var(--border-color);
	}

	.spec-label {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-muted);
	}

	.spec-value {
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--text-primary);
		text-align: right;
	}

	.spec-value code {
		font-family: inherit;
		font-size: 0.78rem;
		color: var(--accent-color, #a970ff);
	}

	@media (max-width: 580px) {
		.spec-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.25rem;
		}

		.spec-value {
			text-align: left;
		}
	}
</style>
