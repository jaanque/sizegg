---
import Navigation from '../components/Navigation.astro';
import EmoteDropzone from '../components/EmoteDropzone.astro';
import FAQAndGuide from "../components/FAQAndGuide.astro";
import SEOContentSection from '../components/SEOContentSection.astro';
import SEO from '../components/SEO.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<SEO
			title="YouTube Emote Resizer - sizeGG"
			description="Resize channel emotes and member badges for YouTube for free online. Converts images to exact 480×480px specifications for static PNG and animated GIFs."
			lang="en"
			canonicalUrl="https://sizegg.com/youtube-emote-resizer"
			alternateEsUrl="https://sizegg.com/es/redimensionar-emotes-youtube"
			alternateEnUrl="https://sizegg.com/youtube-emote-resizer"
			platformId="youtube"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TQ5FN8ZQ"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<div class="layout">
			<!-- Header -->
			<header class="header">
				<Navigation lang="en" platform="youtube" />
			</header>

			<!-- Interactive Content -->
			<main class="main-content">
				<h1 class="page-title">YouTube Emote Resizer</h1>
				<EmoteDropzone lang="en" platformId="youtube" accentColor="#ff0000" />
				<SEOContentSection lang="en" platformId="youtube" />

				<!-- Mini Guide & FAQ (FAQ + Schema Markup) -->
				<FAQAndGuide lang="en" platformId="youtube" />
			</main>

			<Footer lang="en" />
		</div>

		<style>
			:root {
				--bg-body: #101216;
				--surface-card: #17191e;
				--surface-hover: #1f2229;
				--border-color: #2b2f38;
				--text-primary: #f1f3f5;
				--text-muted: #8a93a0;
				--accent-youtube: #ff0000;
				--accent-youtube-bg: rgba(255, 0, 0, 0.08);
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
				background-color: var(--bg-body);
				color: var(--text-primary);
				min-height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 2rem 1rem;
			}

			@media (max-width: 520px) {
				body {
					padding: 1.5rem 0.75rem;
					align-items: flex-start;
				}
			}

			.layout {
				margin-top: 3rem;
				width: 100%;
				max-width: 820px;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			.header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 1.25rem; box-sizing: border-box; width: 100%;
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 22px;
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.6rem;
			}

			.brand-title-link {
				text-decoration: none;
				color: inherit;
			}

			.brand-title {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--text-primary);
			}

			.main-content {
				width: 100%;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.page-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: var(--text-primary);
				letter-spacing: -0.01em;
			}

		</style>
	</body>
</html>
