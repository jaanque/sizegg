---
import SEO from '../components/SEO.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const lang = 'en';
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<SEO 
			title="Terms of Service | sizeGG" 
			description="Review the Terms of Service for sizeGG. Learn about user responsibilities, intellectual property, and service terms."
			lang="en"
			canonicalUrl="https://size.gg/terms"
			alternateEnUrl="https://size.gg/terms"
			alternateEsUrl="https://size.gg/es/terminos"
		/>
	</head>
	<body>
		<div class="layout">
			<Navigation lang="en" />

			<main class="main-content">
				<div class="policy-card">
					<h1 class="policy-title">Terms of Service</h1>
					<p class="policy-updated">Last Updated: August 6, 2026</p>

					<section class="policy-section">
						<h2>1. Acceptance of Terms</h2>
						<p>
							By accessing or using <strong>sizeGG</strong> at <a href="https://size.gg">size.gg</a>, you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use our website.
						</p>
					</section>

					<section class="policy-section">
						<h2>2. Description of Service</h2>
						<p>
							sizeGG provides free web-based tools for resizing, cropping, and converting image files for content creation across streaming and social platforms (such as Twitch, Kick, Discord, YouTube, 7TV, and BTTV). All processing is executed client-side inside your web browser.
						</p>
					</section>

					<section class="policy-section">
						<h2>3. User Intellectual Property & Ownership</h2>
						<p>
							You retain full ownership and intellectual property rights to any images, graphics, or emotes you process using sizeGG. We do not claim any ownership over your content. You represent and warrant that you hold all necessary rights and copyrights for any media you process using our tool.
						</p>
					</section>

					<section class="policy-section">
						<h2>4. Acceptable Use</h2>
						<p>You agree not to use sizeGG for any unlawful purpose or to process content that violates third-party copyrights, trademarks, or publicity rights.</p>
					</section>

					<section class="policy-section">
						<h2>5. Disclaimer of Warranties</h2>
						<p>
							sizeGG is provided on an <strong>"AS IS"</strong> and <strong>"AS AVAILABLE"</strong> basis without warranties of any kind, whether express or implied. We do not guarantee uninterrupted access, error-free operation, or that output files will meet specific platform guidelines if third-party platform policies change.
						</p>
					</section>

					<section class="policy-section">
						<h2>6. Limitation of Liability</h2>
						<p>
							In no event shall sizeGG, its operators, or contributors be liable for any indirect, incidental, consequential, or punitive damages arising from your use of or inability to use the service.
						</p>
					</section>

					<section class="policy-section">
						<h2>7. Contact</h2>
						<p>For any questions regarding these Terms, please contact us at: <a href="mailto:contact@size.gg">contact@size.gg</a></p>
					</section>
				</div>
			</main>

			<Footer lang="en" />
		</div>

		<style>
			:root {
				--bg-body: #101216;
				--surface-card: #17191e;
				--surface-hover: #1f2229;
				--border-color: #2b2f38;
				--text-primary: #f1f3f5;
				--text-muted: #8a93a0;
				--accent-color: #9146ff;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
				background-color: var(--bg-body);
				color: var(--text-primary);
				min-height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 2rem 1rem;
			}

			@media (max-width: 520px) {
				body {
					padding: 1.5rem 0.75rem;
					align-items: flex-start;
				}
			}

			.layout {
				margin-top: 3rem;
				width: 100%;
				max-width: 820px;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			.main-content {
				width: 100%;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.policy-card {
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 22px;
				padding: 1.75rem;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			.policy-title {
				font-size: 1.5rem;
				font-weight: 800;
				color: var(--text-primary);
				letter-spacing: -0.02em;
			}

			.policy-updated {
				font-size: 0.8rem;
				color: var(--text-muted);
				margin-top: -0.75rem;
			}

			.policy-section {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.policy-section h2 {
				font-size: 1.05rem;
				font-weight: 700;
				color: var(--text-primary);
			}

			.policy-section p {
				font-size: 0.88rem;
				color: var(--text-muted);
				line-height: 1.6;
			}

			.policy-section a {
				color: var(--accent-color);
				text-decoration: none;
			}

			.policy-section a:hover {
				text-decoration: underline;
			}
		</style>
	</body>
</html>
