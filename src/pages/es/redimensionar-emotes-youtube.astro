---
import Navigation from "../../components/Navigation.astro";
import EmoteDropzone from "../../components/EmoteDropzone.astro";
import FAQAndGuide from "../../components/FAQAndGuide.astro";
import SEOContentSection from "../../components/SEOContentSection.astro";
import SEO from "../../components/SEO.astro";
import Footer from "../../components/Footer.astro";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<SEO
			title="Emote Resizer YouTube - Redimensionar Emotes y GIFs para YouTube Gratis | sizeGG"
			description="Emote resizer online gratis para YouTube. Redimensiona emotes de chat e insignias de lealtad a la medida requerida de 480×480px en PNG y GIF."
			lang="es"
			canonicalUrl="https://sizegg.com/es/redimensionar-emotes-youtube"
			alternateEsUrl="https://sizegg.com/es/redimensionar-emotes-youtube"
			alternateEnUrl="https://sizegg.com/youtube-emote-resizer"
			platformId="youtube"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-TQ5FN8ZQ"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		<!-- End Google Tag Manager (noscript) -->
		<div class="layout">
			<!-- Header -->
			<header class="header">
				<Navigation lang="es" platform="youtube" />
			</header>

			<!-- Contenido interactivo -->
			<main class="main-content">
				<h1 class="page-title">
					Redimensionar Emotes para YouTube y redimensionar GIFs
				</h1>
				<EmoteDropzone
					lang="es"
					platformId="youtube"
					accentColor="#ff0000"
				/>
				<SEOContentSection lang="es" platformId="youtube" />

				<!-- Miniguía y Preguntas Frecuentes (FAQ + Schema Markup) -->
				<FAQAndGuide lang="es" platformId="youtube" />
			</main>

			<Footer lang="es" />
		</div>

		<style>
			:root {
				--bg-body: #0f0f0f;
				--surface-card: #181818;
				--surface-hover: #222222;
				--border-color: #2a2a2a;
				--text-primary: #f1f1f1;
				--text-muted: #aaaaaa;
				--accent-youtube: #ff0000;
				--accent-youtube-bg: rgba(255, 0, 0, 0.08);
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family:
					"Plus Jakarta Sans",
					system-ui,
					-apple-system,
					sans-serif;
				background-color: var(--bg-body);
				color: var(--text-primary);
				min-height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 3rem 1.5rem;
			}

			@media (max-width: 520px) {
				body {
					padding: 2rem 1rem;
					align-items: flex-start;
				}
			}

			.layout {
				width: 100%;
				max-width: 820px;
				padding: 2rem 1rem;
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}

			.header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 1.25rem;
				box-sizing: border-box;
				width: 100%;
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 22px;
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.6rem;
			}

			.brand-title-link {
				text-decoration: none;
				color: inherit;
			}

			.brand-title {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--text-primary);
			}

			.main-content {
				width: 100%;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.page-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: var(--text-primary);
				letter-spacing: -0.01em;
			}

			.info-card {
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 22px;
				padding: 1rem 1.25rem;
				display: flex;
				flex-direction: column;
				gap: 0.65rem;
			}

			.info-header {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.875rem;
				font-weight: 600;
				color: var(--text-primary);
			}

			.info-icon {
				color: var(--accent-youtube);
			}

			.info-list {
				list-style-type: none;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				font-size: 0.8rem;
				color: var(--text-muted);
				padding-left: 1.6rem;
			}

			.info-list li {
				position: relative;
			}

			.info-list li::before {
				content: "•";
				color: var(--accent-youtube);
				position: absolute;
				left: -1rem;
				font-weight: bold;
			}
		</style>
	</body>
</html>
