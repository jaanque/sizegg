---
import Navigation from '../../components/Navigation.astro';
import EmoteDropzone from '../../components/EmoteDropzone.astro';
import FAQAndGuide from '../../components/FAQAndGuide.astro';
import SEOContentSection from '../../components/SEOContentSection.astro';
import SEO from '../../components/SEO.astro';
import Footer from '../../components/Footer.astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<SEO
			title="Redimensionar Emotes Twitch - sizeGG"
			description="Redimensiona y convierte tus emotes para Twitch gratis online. Ajusta automáticamente imágenes estáticas (PNG) y animadas (GIF) a 112×112px, 56×56px y 28×28px."
			lang="es"
			canonicalUrl="https://sizegg.com/es/redimensionar-emotes-twitch"
			alternateEsUrl="https://sizegg.com/es/redimensionar-emotes-twitch"
			alternateEnUrl="https://sizegg.com/twitch-emote-resizer"
			platformId="twitch"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TQ5FN8ZQ"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<div class="layout">
			<!-- Header -->
			<header class="header">
				<Navigation lang="es" platform="twitch" />
			</header>

			<!-- Contenido interactivo -->
			<main class="main-content">
				<h1 class="page-title">Redimensionar Emotes para Twitch</h1>
				<EmoteDropzone lang="es" platformId="twitch" accentColor="#a970ff" />
				<SEOContentSection lang="es" platformId="twitch" />

				<!-- Miniguía y Preguntas Frecuentes (FAQ + Schema Markup) -->
				<FAQAndGuide lang="es" platformId="twitch" />
			</main>

			<Footer lang="es" />
		</div>

		<style>
			:root {
				--bg-body: #111317;
				--surface-card: #181b20;
				--surface-hover: #1f2329;
				--border-color: #2b3038;
				--text-primary: #f1f3f5;
				--text-muted: #8c95a3;
				--accent-twitch: #a970ff;
				--accent-twitch-bg: rgba(169, 112, 255, 0.08);
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
				background-color: var(--bg-body);
				color: var(--text-primary);
				min-height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 3rem 1.5rem;
			}

			@media (max-width: 520px) {
				body {
					padding: 2rem 1rem;
					align-items: flex-start;
				}
			}

			.layout {
				width: 100%;
				max-width: 820px;
				padding: 2rem 1rem;
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}

			.header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 1.25rem;
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 22px;
				box-sizing: border-box;
				width: 100%;
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.6rem;
			}

			.brand-title-link {
				text-decoration: none;
				color: inherit;
			}

			.brand-title {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--text-primary);
			}

			.main-content {
				width: 100%;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.page-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: var(--text-primary);
				letter-spacing: -0.01em;
			}

			.info-card {
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 22px;
				padding: 1rem 1.25rem;
				display: flex;
				flex-direction: column;
				gap: 0.65rem;
			}

			.info-header {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.875rem;
				font-weight: 600;
				color: var(--text-primary);
			}

			.info-icon {
				color: var(--accent-twitch);
			}

			.info-list {
				list-style-type: none;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				font-size: 0.8rem;
				color: var(--text-muted);
				padding-left: 1.6rem;
			}

			.info-list li {
				position: relative;
			}

			.info-list li::before {
				content: "•";
				color: var(--accent-twitch);
				position: absolute;
				left: -1rem;
				font-weight: bold;
			}
		</style>
	</body>
</html>
