---
import Navigation from '../../components/Navigation.astro';
import EmoteDropzone from '../../components/EmoteDropzone.astro';
import FAQAndGuide from "../../components/FAQAndGuide.astro";
import SEOContentSection from '../../components/SEOContentSection.astro';
import SEO from '../../components/SEO.astro';
import Footer from '../../components/Footer.astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<SEO
			title="Redimensionar Emotes Kick - sizeGG"
			description="Redimensiona tus emotes para Kick gratis online. Convierte y ajusta automáticamente imágenes estáticas (PNG) y animadas (GIF) a 500×500px cumpliendo los límites de peso de Kick."
			lang="es"
			canonicalUrl="https://sizegg.com/es/redimensionar-emotes-kick"
			alternateEsUrl="https://sizegg.com/es/redimensionar-emotes-kick"
			alternateEnUrl="https://sizegg.com/en/kick-emote-resizer"
			platformId="kick"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="layout">
			<!-- Header -->
			<header class="header">
				<Navigation lang="es" platform="kick" />
			</header>

			<!-- Contenido interactivo -->
			<main class="main-content">
				<h1 class="page-title">Redimensionar Emotes para Kick</h1>
				<EmoteDropzone lang="es" platformId="kick" accentColor="#53fc18" />
				<SEOContentSection lang="es" platformId="kick" />

				<!-- Miniguía y Preguntas Frecuentes (FAQ + Schema Markup) -->
				<FAQAndGuide lang="es" platformId="kick" accentColor="#53fc18" />
			</main>

			<Footer lang="es" />
		</div>

		<style>
			:root {
				--bg-body: #0d0f12;
				--surface-card: #15181e;
				--surface-hover: #1c2028;
				--border-color: #272c35;
				--text-primary: #f1f3f5;
				--text-muted: #808a9a;
				--accent-kick: #53fc18;
				--accent-kick-bg: rgba(83, 252, 24, 0.06);
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
				background-color: var(--bg-body);
				color: var(--text-primary);
				min-height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 2rem 1rem;
			}

			.layout {
				margin-top: 3rem;
				width: 100%;
				max-width: 760px;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			.header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 1.25rem; box-sizing: border-box; width: 100%;
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 12px;
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.6rem;
			}

			.brand-title-link {
				text-decoration: none;
				color: inherit;
			}

			.brand-title {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--text-primary);
			}

			.main-content {
				width: 100%;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.page-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: var(--text-primary);
				letter-spacing: -0.01em;
			}

			.info-card {
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 1rem 1.25rem;
				display: flex;
				flex-direction: column;
				gap: 0.65rem;
			}

			.info-header {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.875rem;
				font-weight: 600;
				color: var(--text-primary);
			}

			.info-icon {
				color: var(--accent-kick);
			}

			.info-list {
				list-style-type: none;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				font-size: 0.8rem;
				color: var(--text-muted);
				padding-left: 1.6rem;
			}

			.info-list li {
				position: relative;
			}

			.info-list li::before {
				content: "•";
				color: var(--accent-kick);
				position: absolute;
				left: -1rem;
				font-weight: bold;
			}
		</style>
	</body>
</html>
