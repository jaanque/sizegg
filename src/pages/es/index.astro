---
const platforms = [
	{
		id: 'twitch',
		name: 'Twitch',
		href: '/es/redimensionar-emotes-twitch',
		desc: 'Redimensiona tus emotes en los 3 tamaños oficiales para Twitch manteniendo máxima nitidez.',
		specs: '112×112, 56×56 y 28×28px',
		accent: '#a970ff',
		accentBg: 'rgba(169, 112, 255, 0.08)',
		svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M11.571 4.714h1.715v5.143H11.571zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/></svg>`
	},
	{
		id: 'kick',
		name: 'Kick',
		href: '/es/redimensionar-emotes-kick',
		desc: 'Convierte cualquier imagen al formato cuadrado exigido para tu panel de creadores en Kick.',
		specs: '500×500px',
		accent: '#53fc18',
		accentBg: 'rgba(83, 252, 24, 0.08)',
		svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h4v6.5L13.5 3H19l-7.2 8.5L19.5 21h-5.6L8 13.5V21H3V3z"/></svg>`
	},
	{
		id: 'discord',
		name: 'Discord',
		href: '/es/redimensionar-emotes-discord',
		desc: 'Adapta fotos y memes a emojis y stickers optimizados para tu servidor de Discord.',
		specs: '128×128px',
		accent: '#5865f2',
		accentBg: 'rgba(88, 101, 242, 0.08)',
		svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>`
	},
	{
		id: 'youtube',
		name: 'YouTube',
		href: '/es/redimensionar-emotes-youtube',
		desc: 'Ajusta emotes de chat e insignias de lealtad para miembros en directos de YouTube.',
		specs: '480×480px',
		accent: '#ff0000',
		accentBg: 'rgba(255, 0, 0, 0.08)',
		svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`
	},
	{
		id: '7tv',
		name: '7TV',
		href: '/es/redimensionar-emotes-7tv',
		desc: 'Redimensiona emotes en alta definición WebP y GIF animados para la extensión 7TV.',
		specs: '128×128px',
		accent: '#38bdf8',
		accentBg: 'rgba(56, 189, 248, 0.08)',
		svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M2 4h20v3H9l-5 13H1v-3l3-10H2V4zm7 6h13v3H13l-4 10H6v-3l3-10z"/></svg>`
	},
	{
		id: 'bttv',
		name: 'BTTV',
		href: '/es/redimensionar-emotes-bttv',
		desc: 'Genera en 1 solo clic los 3 tamaños oficiales para emotes de BetterTTV (BTTV).',
		specs: '112×112, 56×56 y 28×28px',
		accent: '#f97316',
		accentBg: 'rgba(249, 115, 22, 0.08)',
		svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8.293 2.293a1 1 0 0 1 1.414 0L12 4.586l2.293-2.293a1 1 0 1 1 1.414 1.414L13.414 6H18a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4v-8a4 4 0 0 1 4-4h4.586L8.293 3.707a1 1 0 0 1 0-1.414zM6 8a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2H6zm2.5 3a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zm7 0a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zm-6.25 4.5a.75.75 0 0 1 .75-.75h4a.75.75 0 0 1 0 1.5h-4a.75.75 0 0 1-.75-.75z"/></svg>`
	}
];
import SEO from '../../components/SEO.astro';
import FAQAndGuide from '../../components/FAQAndGuide.astro';
import Footer from '../../components/Footer.astro';
import GlobalCounter from '../../components/GlobalCounter.astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<SEO
			title="Redimensionar Emotes - sizeGG"
			description="Herramienta online gratuita para redimensionar y convertir emotes para Twitch, Kick, Discord, YouTube, 7TV y BTTV. Ajuste automático a resoluciones exactas en PNG y GIF."
			lang="es"
			canonicalUrl="https://sizegg.com/es/"
			alternateEsUrl="https://sizegg.com/es/"
			alternateEnUrl="https://sizegg.com/"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TQ5FN8ZQ"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<div class="container">
			<header class="hero">
				<div class="hero-top">
					<div class="logo-tag" id="hero-logo-tag">sizeGG</div>
					<div class="dropdown-wrapper" id="landing-lang-wrapper">
						<button class="lang-btn" id="landing-lang-btn">
							<span>ES</span>
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="m6 9 6 6 6-6"/>
							</svg>
						</button>
						<div class="dropdown-menu">
							<a href="/es" class="dropdown-item active" data-set-lang="es">Español</a>
							<a href="/" class="dropdown-item" data-set-lang="en">English</a>
						</div>
					</div>
				</div>

				<h1>Adapta tus emotes para cualquier plataforma</h1>
				<p class="hero-subtitle">Selecciona la plataforma a la que quieres subir tu emote y ajustaremos automáticamente los tamaños y especificaciones necesarias.</p>
				<GlobalCounter lang="es" />
			</header>

			<main class="grid-container">
				{platforms.map(p => (
					<a href={p.href} class="platform-card" data-accent={p.accent} data-accent-bg={p.accentBg} style={`--card-accent: ${p.accent}; --card-accent-bg: ${p.accentBg};`}>
						<div class="card-icon" set:html={p.svg} />
						<div class="card-content">
							<h2>{p.name}</h2>
							<span class="card-specs">{p.specs}</span>
						</div>
						<svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M5 12h14"></path>
							<path d="m12 5 7 7-7 7"></path>
						</svg>
					</a>
				))}
			</main>

			<FAQAndGuide lang="es" />

			<Footer lang="es" />
		</div>

		<style>
			:root {
				--bg-body: #101216;
				--surface-card: #17191e;
				--surface-hover: #1f2229;
				--border-color: #2b2f38;
				--text-primary: #f8fafc;
				--text-muted: #94a3b8;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
				background-color: var(--bg-body);
				color: var(--text-primary);
				min-height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 3.5rem 1.5rem;
			}

			@media (max-width: 520px) {
				body {
					padding: 2rem 1rem;
					align-items: flex-start;
				}
			}

			.container {
				width: 100%;
				max-width: 840px;
				padding: 1rem 0.5rem;
				display: flex;
				flex-direction: column;
				gap: 2.5rem;
			}

			.hero {
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
				text-align: center;
				align-items: center;
			}

			.hero-top {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 0.25rem;
			}

			.logo-tag {
				font-size: 1.05rem;
				font-weight: 800;
				color: #a970ff;
				background: rgba(169, 112, 255, 0.1);
				border: 1px solid rgba(169, 112, 255, 0.25);
				padding: 0.35rem 1rem;
				border-radius: 20px;
				letter-spacing: -0.01em;
				box-shadow: 0 0 16px rgba(169, 112, 255, 0.12);
			}

			.dropdown-wrapper {
				position: relative;
			}

			.lang-btn {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				font-family: inherit;
				font-size: 0.85rem;
				font-weight: 700;
				color: var(--text-muted);
				background: var(--surface-card);
				border: 1px solid var(--border-color);
				padding: 0.35rem 0.85rem;
				border-radius: 20px;
				cursor: pointer;
				transition: all 0.2s ease;
			}

			.lang-btn:hover {
				color: var(--text-primary);
				border-color: var(--text-muted);
			}

			.dropdown-menu {
				position: absolute;
				top: calc(100% + 0.4rem);
				right: 0;
				min-width: 120px;
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 16px;
				padding: 0.4rem;
				display: none;
				flex-direction: column;
				gap: 0.2rem;
				z-index: 50;
				box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
			}

			.dropdown-wrapper.open .dropdown-menu {
				display: flex;
			}

			.dropdown-item {
				display: flex;
				align-items: center;
				padding: 0.45rem 0.75rem;
				border-radius: 10px;
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--text-muted);
				text-decoration: none;
				transition: background-color 0.15s ease, color 0.15s ease;
			}

			.dropdown-item:hover,
			.dropdown-item.active {
				color: var(--text-primary);
				background-color: var(--surface-hover);
			}

			h1 {
				font-size: 2.1rem;
				font-weight: 800;
				letter-spacing: -0.03em;
				color: var(--text-primary);
				line-height: 1.25;
			}

			@media (max-width: 520px) {
				h1 {
					font-size: 1.5rem;
				}
			}

			.hero-subtitle {
				font-size: 0.98rem;
				color: var(--text-muted);
				max-width: 560px;
				line-height: 1.55;
			}

			.grid-container {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				gap: 1.1rem;
				width: 100%;
			}

			.platform-card {
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 20px;
				padding: 1.1rem 1.25rem;
				display: flex;
				flex-direction: row;
				align-items: center;
				gap: 0.9rem;
				text-decoration: none;
				color: var(--text-primary);
				transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
				position: relative;
			}

			.platform-card:hover {
				background-color: var(--surface-hover);
				border-color: var(--card-accent);
				box-shadow: 0 10px 30px -8px var(--card-accent-bg);
			}

			.card-icon {
				width: 44px;
				height: 44px;
				border-radius: 14px;
				background-color: var(--card-accent-bg);
				color: var(--card-accent);
				display: flex;
				align-items: center;
				justify-content: center;
				border: 1px solid rgba(255, 255, 255, 0.06);
				flex-shrink: 0;
			}

			.card-content {
				display: flex;
				flex-direction: row;
				align-items: center;
				gap: 0.65rem;
				flex: 1;
				min-width: 0;
			}

			.card-content h2 {
				font-size: 1.1rem;
				font-weight: 700;
				letter-spacing: -0.01em;
				line-height: 1;
				white-space: nowrap;
			}

			.arrow-icon {
				color: var(--text-muted);
				transition: all 0.25s ease;
				opacity: 0.7;
				flex-shrink: 0;
				margin-left: auto;
			}

			.platform-card:hover .arrow-icon {
				color: var(--card-accent);
				opacity: 1;
			}

			.card-specs {
				display: inline-flex;
				align-items: center;
				font-size: 0.72rem;
				font-weight: 600;
				color: var(--text-muted);
				background-color: rgba(255, 255, 255, 0.04);
				border: 1px solid rgba(255, 255, 255, 0.08);
				padding: 0.22rem 0.6rem;
				border-radius: 12px;
				letter-spacing: 0.01em;
				white-space: nowrap;
				transition: color 0.2s ease, border-color 0.2s ease;
			}

			.platform-card:hover .card-specs {
				color: var(--text-primary);
				border-color: rgba(255, 255, 255, 0.15);
			}

			@media (max-width: 580px) {
				.grid-container {
					grid-template-columns: 1fr;
				}

				.platform-card {
					padding: 1rem 1.1rem;
					gap: 0.75rem;
				}

				.card-content {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.35rem;
				}

				.card-content h2 {
					white-space: normal;
				}

				.card-specs {
					white-space: normal;
					word-break: break-word;
				}
			}
		</style>

		<script>
			const wrapper = document.getElementById('landing-lang-wrapper');
			const btn = document.getElementById('landing-lang-btn');
			const langLinks = document.querySelectorAll('[data-set-lang]');

			langLinks.forEach(link => {
				link.addEventListener('click', () => {
					const lang = link.getAttribute('data-set-lang');
					if (lang) localStorage.setItem('preferred_lang', lang);
				});
			});

			if (wrapper && btn) {
				btn.addEventListener('click', (e) => {
					e.stopPropagation();
					wrapper.classList.toggle('open');
				});
				document.addEventListener('click', () => wrapper.classList.remove('open'));
			}
		</script>
	</body>
</html>
