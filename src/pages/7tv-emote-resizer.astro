---
import Navigation from '../components/Navigation.astro';
import EmoteDropzone from '../components/EmoteDropzone.astro';
import FAQAndGuide from "../components/FAQAndGuide.astro";
import SEOContentSection from '../components/SEOContentSection.astro';
import SEO from '../components/SEO.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<SEO
			title="7TV Emote Resizer - sizeGG"
			description="Resize and convert emotes for 7TV for free online. Auto-scales images to 128×128px in WebP and animated GIF formats."
			lang="en"
			canonicalUrl="https://sizegg.com/7tv-emote-resizer"
			alternateEsUrl="https://sizegg.com/es/redimensionar-emotes-7tv"
			alternateEnUrl="https://sizegg.com/7tv-emote-resizer"
			platformId="7tv"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="layout">
			<!-- Header -->
			<header class="header">
				<Navigation lang="en" platform="7tv" />
			</header>

			<!-- Interactive Content -->
			<main class="main-content">
				<h1 class="page-title">7TV Emote Resizer</h1>
				<EmoteDropzone lang="en" platformId="7tv" accentColor="#38bdf8" />
				<SEOContentSection lang="en" platformId="7tv" />

				<!-- Info Card -->
				<div class="info-card">
					<div class="info-header">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="info-icon">
							<circle cx="12" cy="12" r="10"></circle>
							<line x1="12" y1="16" x2="12" y2="12"></line>
							<line x1="12" y1="8" x2="12.01" y2="8"></line>
						</svg>
						<span>7TV emote requirements & format specs</span>
					</div>
					<ul class="info-list">
						<li><strong>Upload extensions:</strong> <code>.png</code>, <code>.jpg</code>, <code>.jpeg</code>, <code>.webp</code>, <code>.gif</code>, <code>.bmp</code></li>
						<li><strong>Output formats (7TV):</strong> Preferred <code>.webp</code> or <code>.gif</code> (high fidelity animated).</li>
						<li><strong>Recommended dimensions:</strong> 128×128px (auto-scaled 1x, 2x, 3x, 4x).</li>
						<li><strong>Max file size:</strong> 5 MB per file.</li>
					</ul>
				</div>
				<!-- Mini Guide & FAQ (FAQ + Schema Markup) -->
				<FAQAndGuide lang="en" platformId="7tv" />
			</main>

			<Footer lang="en" />
		</div>

		<style>
			:root {
				--bg-body: #0d1117;
				--surface-card: #161b22;
				--surface-hover: #21262d;
				--border-color: #30363d;
				--text-primary: #f0f6fc;
				--text-muted: #8b949e;
				--accent-7tv: #38bdf8;
				--accent-7tv-bg: rgba(56, 189, 248, 0.08);
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
				background-color: var(--bg-body);
				color: var(--text-primary);
				min-height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 2rem 1rem;
			}

			@media (max-width: 520px) {
				body {
					padding: 1.5rem 0.75rem;
					align-items: flex-start;
				}
			}

			.layout {
				margin-top: 3rem;
				width: 100%;
				max-width: 760px;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			.header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 1.25rem; box-sizing: border-box; width: 100%;
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 12px;
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.6rem;
			}

			.brand-title-link {
				text-decoration: none;
				color: inherit;
			}

			.brand-title {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--text-primary);
			}

			.main-content {
				width: 100%;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.page-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: var(--text-primary);
				letter-spacing: -0.01em;
			}

			.info-card {
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 1rem 1.25rem;
				display: flex;
				flex-direction: column;
				gap: 0.65rem;
			}

			.info-header {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.875rem;
				font-weight: 600;
				color: var(--text-primary);
			}

			.info-icon {
				color: var(--accent-7tv);
			}

			.info-list {
				list-style-type: none;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				font-size: 0.8rem;
				color: var(--text-muted);
				padding-left: 1.6rem;
			}

			.info-list li {
				position: relative;
			}

			.info-list li::before {
				content: "•";
				color: var(--accent-7tv);
				position: absolute;
				left: -1rem;
				font-weight: bold;
			}
		</style>
	</body>
</html>
