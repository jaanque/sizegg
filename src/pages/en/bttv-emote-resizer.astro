---
import Navigation from '../../components/Navigation.astro';
import EmoteDropzone from '../../components/EmoteDropzone.astro';
import FAQAndGuide from "../../components/FAQAndGuide.astro";
import SEOContentSection from '../../components/SEOContentSection.astro';
import SEO from '../../components/SEO.astro';
import Footer from '../../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<SEO
			title="BTTV Emote Resizer - sizeGG"
			description="Resize emotes for BetterTTV (BTTV) online for free. Instantly generates 112×112px, 56×56px, and 28×28px resolutions in PNG and GIF."
			lang="en"
			canonicalUrl="https://sizegg.com/en/bttv-emote-resizer"
			alternateEsUrl="https://sizegg.com/es/redimensionar-emotes-bttv"
			alternateEnUrl="https://sizegg.com/en/bttv-emote-resizer"
			platformId="bttv"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="layout">
			<!-- Header -->
			<header class="header">
				<Navigation lang="en" platform="bttv" />
			</header>

			<!-- Interactive Content -->
			<main class="main-content">
				<h1 class="page-title">BTTV Emote Resizer</h1>
				<EmoteDropzone lang="en" platformId="bttv" accentColor="#f97316" />
				<SEOContentSection lang="en" platformId="bttv" />

				<!-- Info Card -->
				<div class="info-card">
					<div class="info-header">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="info-icon">
							<circle cx="12" cy="12" r="10"></circle>
							<line x1="12" y1="16" x2="12" y2="12"></line>
							<line x1="12" y1="8" x2="12.01" y2="8"></line>
						</svg>
						<span>BTTV emote requirements & format specs</span>
					</div>
					<ul class="info-list">
						<li><strong>Upload extensions:</strong> <code>.png</code>, <code>.jpg</code>, <code>.jpeg</code>, <code>.webp</code>, <code>.gif</code>, <code>.bmp</code></li>
						<li><strong>Output formats (BTTV):</strong> <code>.png</code> (static images) and <code>.gif</code> (animated).</li>
						<li><strong>Standard dimensions:</strong> 112×112px, 56×56px and 28×28px.</li>
						<li><strong>Max file size:</strong> 3 MB per file.</li>
					</ul>
				</div>
				<!-- Mini Guide & FAQ (FAQ + Schema Markup) -->
				<FAQAndGuide lang="en" platformId="bttv" />
			</main>

			<Footer lang="en" />
		</div>

		<style>
			:root {
				--bg-body: #101418;
				--surface-card: #171d22;
				--surface-hover: #20272e;
				--border-color: #2b343d;
				--text-primary: #f0f4f8;
				--text-muted: #8896a4;
				--accent-bttv: #f97316;
				--accent-bttv-bg: rgba(249, 115, 22, 0.08);
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
				background-color: var(--bg-body);
				color: var(--text-primary);
				min-height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 2rem 1rem;
			}

			.layout {
				margin-top: 3rem;
				width: 100%;
				max-width: 760px;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			.header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 1.25rem; box-sizing: border-box; width: 100%;
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 12px;
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.6rem;
			}

			.brand-title-link {
				text-decoration: none;
				color: inherit;
			}

			.brand-title {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--text-primary);
			}

			.main-content {
				width: 100%;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.page-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: var(--text-primary);
				letter-spacing: -0.01em;
			}

			.info-card {
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 1rem 1.25rem;
				display: flex;
				flex-direction: column;
				gap: 0.65rem;
			}

			.info-header {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.875rem;
				font-weight: 600;
				color: var(--text-primary);
			}

			.info-icon {
				color: var(--accent-bttv);
			}

			.info-list {
				list-style-type: none;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				font-size: 0.8rem;
				color: var(--text-muted);
				padding-left: 1.6rem;
			}

			.info-list li {
				position: relative;
			}

			.info-list li::before {
				content: "•";
				color: var(--accent-bttv);
				position: absolute;
				left: -1rem;
				font-weight: bold;
			}
		</style>
	</body>
</html>
