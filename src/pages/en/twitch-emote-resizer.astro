---
import Navigation from '../../components/Navigation.astro';
import EmoteDropzone from '../../components/EmoteDropzone.astro';
import FAQAndGuide from "../../components/FAQAndGuide.astro";
import SEOContentSection from '../../components/SEOContentSection.astro';
import SEO from '../../components/SEO.astro';
import Footer from '../../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<SEO
			title="Twitch Emote Resizer - sizeGG"
			description="Resize and convert emotes for Twitch instantly for free online. Automatically outputs 112×112px, 56×56px, and 28×28px in static PNG and animated GIF."
			lang="en"
			canonicalUrl="https://sizegg.com/en/twitch-emote-resizer"
			alternateEsUrl="https://sizegg.com/es/redimensionar-emotes-twitch"
			alternateEnUrl="https://sizegg.com/en/twitch-emote-resizer"
			platformId="twitch"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="layout">
			<!-- Header -->
			<header class="header">
				<Navigation lang="en" platform="twitch" />
			</header>

			<!-- Interactive Content -->
			<main class="main-content">
				<h1 class="page-title">Twitch Emote Resizer</h1>
				<EmoteDropzone lang="en" platformId="twitch" accentColor="#a970ff" />
				<SEOContentSection lang="en" platformId="twitch" />

				<!-- Mini Guide & FAQ (FAQ + Schema Markup) -->
				<FAQAndGuide lang="en" platformId="twitch" />
			</main>

			<Footer lang="en" />
		</div>

		<style>
			:root {
				--bg-body: #111317;
				--surface-card: #181b20;
				--surface-hover: #1f2329;
				--border-color: #2b3038;
				--text-primary: #f1f3f5;
				--text-muted: #8c95a3;
				--accent-twitch: #a970ff;
				--accent-twitch-bg: rgba(169, 112, 255, 0.08);
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
				background-color: var(--bg-body);
				color: var(--text-primary);
				min-height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 2rem 1rem;
			}

			@media (max-width: 520px) {
				body {
					padding: 1.5rem 0.75rem;
					align-items: flex-start;
				}
			}

			.layout {
				margin-top: 3rem;
				width: 100%;
				max-width: 760px;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			.header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 1.25rem; box-sizing: border-box; width: 100%;
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 12px;
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.6rem;
			}

			.brand-title-link {
				text-decoration: none;
				color: inherit;
			}

			.brand-title {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--text-primary);
			}

			.main-content {
				width: 100%;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.page-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: var(--text-primary);
				letter-spacing: -0.01em;
			}

			.info-card {
				background-color: var(--surface-card);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 1rem 1.25rem;
				display: flex;
				flex-direction: column;
				gap: 0.65rem;
			}

			.info-header {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.875rem;
				font-weight: 600;
				color: var(--text-primary);
			}

			.info-icon {
				color: var(--accent-twitch);
			}

			.info-list {
				list-style-type: none;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				font-size: 0.8rem;
				color: var(--text-muted);
				padding-left: 1.6rem;
			}

			.info-list li {
				position: relative;
			}

			.info-list li::before {
				content: "•";
				color: var(--accent-twitch);
				position: absolute;
				left: -1rem;
				font-weight: bold;
			}
		</style>
	</body>
</html>
